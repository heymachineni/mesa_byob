# Google OAuth — https://console.cloud.google.com/apis/credentials
#
# The client ID is public: it ships to the browser and appears in the sign-in
# URL. The secret is not, and must never be committed. Copy this file to `.env`
# and paste the secret there; `.env` is gitignored.

GOOGLE_CLIENT_ID=1078936928250-raijrc38jovj58ske4iq296m10qtcnna.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Any long random string — generate one with:
#   openssl rand -base64 48
SESSION_SECRET=

# Who is allowed in. The consent screen is published as External, so *any*
# Google account can complete sign-in — this is what actually gates access.
# Comma-separated, no @.
ALLOWED_EMAIL_DOMAINS=mesaschool.co,forge27.mesaschool.co

# Where Google sends the user back. Must match the Authorized redirect URI in
# the console exactly. Leave unset and the app derives it from the request.
# PUBLIC_SITE_URL=https://mesa-byob.vercel.app
