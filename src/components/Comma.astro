---
/**
 * The Forge "comma" — Mesa's golden-spiral leaf element.
 *
 * Used exactly twice on the site: once behind the opening statement and once
 * at the Flea finale. It is a brand gesture at two moments, not wallpaper.
 *
 * NOTE FOR MESA: assets/brand_element_violet.png and brand_element_aubergine.png
 * were referenced in the design system but not supplied. This is drawn to the
 * written description; swap in the official asset when available.
 *
 * Positioning lives on a wrapper in the parent — Astro does not forward a
 * parent's scoped-style attribute to a child component's root node.
 */
interface Props {
  tone?: 'orchid' | 'aubergine' | 'violet';
  opacity?: number;
}
const { tone = 'orchid', opacity = 1 } = Astro.props;

const fill = {
  orchid: 'var(--forge-orchid)',
  aubergine: 'var(--forge-aubergine)',
  violet: 'var(--forge-violet)',
}[tone];
---

<svg
  class="comma"
  viewBox="0 0 200 200"
  fill="none"
  aria-hidden="true"
  focusable="false"
  style={`--comma-fill:${fill};opacity:${opacity}`}
>
  <!-- Two opposing quarter-arcs meeting at tapered tips on the diagonal. -->
  <path d="M14 186 C14 91 91 14 186 14 C186 109 109 186 14 186 Z" fill="var(--comma-fill)"
  ></path>
</svg>

<style>
  .comma {
    display: block;
    inline-size: 100%;
    block-size: auto;
    pointer-events: none;
  }
</style>
