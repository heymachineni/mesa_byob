---
import { youTubeId } from '../lib/format';

/**
 * A real, responsive YouTube embed — not a card with a play button.
 *
 * `loading="lazy"` means the player is only fetched when it approaches the
 * viewport, and iframes inside a closed drawer (display:none) are never
 * fetched at all. That keeps the "embed directly" behaviour without paying
 * for every video on the page up front.
 *
 * Videos the source marks [Add link] render as a designed empty slot. No URL
 * is ever invented.
 */
interface Props {
  video: {
    title: string;
    url: string | null;
    source: string;
    kind: 'youtube' | 'instagram' | 'link';
    placeholder: boolean;
    note?: string | undefined;
  };
}
const { video } = Astro.props;
const ytId = video.kind === 'youtube' ? youTubeId(video.url) : null;
const isEmpty = video.placeholder || !video.url;
---

{
  ytId ? (
    <figure class="vid">
      <div class="vid__frame">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${ytId}?rel=0`}
          title={video.title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        />
      </div>
      <figcaption class="vid__cap">
        <span class="vid__title">{video.title}</span>
        <span class="vid__src">{video.source}</span>
      </figcaption>
    </figure>
  ) : isEmpty ? (
    <div class="vid vid--empty">
      <div class="vid__frame vid__frame--empty">
        <span class="vid__slot label">Slot reserved</span>
      </div>
      <div class="vid__cap">
        <span class="vid__title">{video.title}</span>
        <span class="vid__src">{video.source} — link to be added</span>
        {video.note && <span class="vid__note">{video.note}</span>}
      </div>
    </div>
  ) : (
    <a class="vid vid--link" href={video.url} target="_blank" rel="noopener noreferrer">
      <div class="vid__frame vid__frame--link">
        <span class="vid__ext">
          {video.kind === 'instagram' ? 'Instagram' : 'Open'} <span class="arrow">↗</span>
        </span>
      </div>
      <div class="vid__cap">
        <span class="vid__title">{video.title}</span>
        <span class="vid__src">{video.source}</span>
        {video.note && <span class="vid__note">{video.note}</span>}
      </div>
    </a>
  )
}

<style>
  .vid {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    text-decoration: none;
    color: inherit;
    min-inline-size: 0;
  }

  .vid__frame {
    position: relative;
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface-inset);
    border: 1px solid var(--border);
  }
  .vid__frame :global(iframe) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    border: 0;
  }

  .vid__frame--empty {
    display: grid;
    place-items: center;
    border-style: dashed;
    background: none;
  }
  .vid__slot {
    color: var(--text-faint);
  }

  .vid__frame--link {
    display: grid;
    place-items: center;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .vid--link:hover .vid__frame--link {
    border-color: var(--border-strong);
  }
  .vid__ext {
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent-ink);
  }

  .vid__cap {
    display: grid;
    gap: 0.15rem;
  }
  .vid__title {
    font-size: var(--step--1);
    font-weight: 650;
    line-height: 1.4;
    color: var(--text-strong);
    text-wrap: pretty;
  }
  .vid__src {
    font-size: var(--step--2);
    color: var(--text-faint);
  }
  .vid__note {
    font-size: var(--step--2);
    color: var(--text-faint);
    font-style: italic;
    line-height: var(--leading-body);
  }
  .vid--empty {
    opacity: 0.75;
  }
</style>
