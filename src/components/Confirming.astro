---
/**
 * A fact the Starter Pack's text and its milestones graphic disagree on.
 *
 * Rather than silently picking one, the value renders with a visible marker and
 * the disagreement is stated. See AUDIT.md §2. Once Mesa confirms a value,
 * delete the `*Confirming` key from the JSON and the marker disappears on its own.
 */
interface Props {
  note: string;
  class?: string;
}
const { note, class: className = '' } = Astro.props;
---

<span class:list={['confirming', className]} title={note}>
  <slot />
  <span class="sr-only"> (being confirmed: {note})</span>
</span>
