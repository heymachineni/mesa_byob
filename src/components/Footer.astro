---
import Logo from './Logo.astro';
import { getProgram } from '../lib/content';

const program = await getProgram();

const explore = [
  { href: '#journey', label: 'The journey' },
  { href: '#channels', label: 'Five ways to sell' },
  { href: '#workshops', label: 'Workshops' },
  { href: '#money', label: 'Money matters' },
  { href: '#flea', label: 'Mesa Flea' },
  { href: '#faq', label: 'FAQ' },
];

const resources = [
  { href: '#stuck', label: "When you're stuck" },
  { href: '#watch', label: 'Watch & learn' },
  { href: '#gate-map', label: 'Investment gates' },
  { href: '#targets', label: 'Channel targets' },
];
---

<footer class="ftr band" data-tone="deep">
  <div class="u-container ftr__inner">
    <div class="ftr__brand">
      <Logo />
      <p class="ftr__kit">BYOB Starter Kit</p>
      <p class="ftr__prog">{program.title} · {program.programme}</p>
      <p class="ftr__dates mono">{program.startLabel} — {program.endLabel}</p>
    </div>

    <nav class="ftr__col" aria-label="Explore">
      <h2 class="ftr__h">Explore</h2>
      <ul>{explore.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
    </nav>

    <nav class="ftr__col" aria-label="Resources">
      <h2 class="ftr__h">Resources</h2>
      <ul>{resources.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
    </nav>

    <div class="ftr__col ftr__say">
      <h2 class="ftr__h">Before you start</h2>
      <p class="ftr__note hand">
        Eight weeks is not long. Pick something people actually want, get it in front of
        them early, and let the numbers tell you the truth.
      </p>
      <button class="ftr__search" type="button" data-cmd-open>
        Search the kit <kbd>⌘K</kbd>
      </button>
    </div>
  </div>

  <div class="u-container ftr__base">
    <p>
      Content from the BYOB Starter Pack. Figures marked <span class="ftr__ast">*</span> are
      still being finalised by the program team; sections marked “coming soon” are genuinely
      still being written.
    </p>
    <a href="#top" class="ftr__top">Back to top <span class="arrow">↑</span></a>
  </div>
</footer>

<style>
  .ftr {
    padding-block-start: var(--section-y);
  }

  .ftr__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
    gap: var(--space-8) var(--space-6);
    padding-block-end: var(--space-9);
  }
  @media (max-width: 60rem) {
    .ftr__inner {
      grid-template-columns: 1fr 1fr;
    }
    .ftr__brand,
    .ftr__say {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 34rem) {
    .ftr__inner {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }

  .ftr__brand {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    align-content: start;
  }
  .ftr__kit {
    font-size: var(--step--2);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--forge-orchid);
    margin-block-start: var(--space-2);
  }
  .ftr__prog {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .ftr__dates {
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  .ftr__h {
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--text-faint);
    margin-block-end: var(--space-4);
  }
  .ftr__col ul {
    display: grid;
    gap: var(--space-3);
  }
  .ftr__col a {
    font-size: var(--step--1);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .ftr__col a:hover {
    color: var(--text-strong);
  }

  .ftr__say {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    justify-items: start;
  }
  .ftr__note {
    font-size: var(--step-0);
    line-height: 1.55;
    color: var(--text-muted);
    max-inline-size: 32ch;
    text-wrap: pretty;
  }
  .ftr__search {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.45rem 0.8rem;
    min-block-size: 2.3rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: var(--step--2);
    font-weight: 650;
    color: var(--text-muted);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .ftr__search:hover {
    border-color: var(--border-strong);
    color: var(--text-strong);
  }
  .ftr__search kbd {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    padding: 0.08rem 0.28rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
  }

  .ftr__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-block-start: 1px solid var(--rule);
    font-size: var(--step--2);
    color: var(--text-faint);
  }
  .ftr__base p {
    max-inline-size: 68ch;
    line-height: var(--leading-body);
  }
  .ftr__ast {
    color: var(--forge-orchid);
  }
  .ftr__top {
    color: var(--forge-orchid);
    text-decoration: none;
    font-weight: 650;
    white-space: nowrap;
  }
</style>
