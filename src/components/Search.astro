---
import { getSearchIndex, SEARCH_SUGGESTIONS } from '../lib/content';

/**
 * ⌘K search. A content-heavy starter kit is far better served by one search
 * field than by twenty navigation destinations.
 *
 * The index is built at build time and inlined as JSON — no API, no fetch,
 * no search library. Results either open a drawer or scroll to a section.
 */
const index = await getSearchIndex();
---

<dialog class="cmd" id="cmd" aria-label="Search the starter kit">
  <form class="cmd__box" method="dialog" onsubmit="return false">
    <div class="cmd__field">
      <svg class="cmd__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
        <path d="M13.5 13.5 L17 17" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
      </svg>
      <input
        id="cmd-input"
        type="text"
        placeholder="Search milestones, channels, workshops, FAQs…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search"
        aria-controls="cmd-results"
        aria-expanded="true"
      />
      <button class="cmd__close" type="button" data-cmd-close>
        <kbd>Esc</kbd><span class="sr-only">Close search</span>
      </button>
    </div>

    <p class="cmd__status sr-only" role="status" aria-live="polite"></p>

    <div class="cmd__results" id="cmd-results" role="listbox" aria-label="Search results"></div>

    <!-- Empty query and no-match both land somewhere useful, never blank. -->
    <div class="cmd__hint" data-cmd-hint>
      <p class="cmd__hint-t" data-cmd-hint-title>Try one of these</p>
      <ul class="cmd__chips">
        {
          SEARCH_SUGGESTIONS.map((s) => (
            <li>
              <button type="button" class="cmd__chip" data-suggest={s}>
                {s}
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <footer class="cmd__foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>Esc</kbd> close</span>
    </footer>
  </form>
</dialog>

<script type="application/json" id="cmd-index" set:html={JSON.stringify(index)} />

<style>
  .cmd {
    inline-size: min(40rem, calc(100vw - 2rem));
    max-inline-size: none;
    margin: max(8vh, 3rem) auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    overflow: hidden;
    box-shadow: 0 24px 70px -30px color-mix(in srgb, var(--forge-aubergine) 60%, transparent);

    opacity: 0;
    translate: 0 -0.5rem;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      translate var(--dur-fast) var(--ease-out),
      overlay var(--dur-fast) allow-discrete,
      display var(--dur-fast) allow-discrete;
  }
  .cmd[open] {
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .cmd[open] {
      opacity: 0;
      translate: 0 -0.5rem;
    }
  }
  .cmd::backdrop {
    background: color-mix(in srgb, var(--forge-aubergine) 50%, transparent);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .cmd__box {
    display: grid;
  }

  .cmd__field {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-block-end: 1px solid var(--rule);
  }
  .cmd__icon {
    inline-size: 1.05rem;
    flex: 0 0 auto;
    color: var(--text-faint);
  }
  .cmd__field input {
    flex: 1 1 auto;
    min-inline-size: 0;
    border: 0;
    background: none;
    font-size: var(--step-0);
    padding-block: 0.35rem;
  }
  .cmd__field input:focus {
    outline: none;
  }
  .cmd__field input::placeholder {
    color: var(--text-faint);
  }
  .cmd__close {
    flex: 0 0 auto;
    color: var(--text-faint);
  }

  kbd {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    padding: 0.12rem 0.32rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    color: var(--text-faint);
  }

  .cmd__status {
    padding: var(--space-3) var(--space-5) 0;
    font-size: var(--step--2);
    color: var(--text-faint);
  }
  .cmd__status:empty {
    display: none;
  }

  .cmd__results {
    max-block-size: min(52vh, 26rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-2);
  }
  .cmd__results:empty {
    display: none;
  }

  /* Result rows are built in JS and therefore never receive Astro's scoped
     style attribute — these selectors must be global to apply at all. */
  :global(.cmd__group) {
    padding: var(--space-3) var(--space-4) var(--space-2);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  :global(.cmd__hit) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem;
    inline-size: 100%;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    transition: background var(--dur-fast) var(--ease-out);
  }
  :global(.cmd__hit[aria-selected='true']),
  :global(.cmd__hit:hover) {
    background: var(--surface-inset);
  }
  /* WHAT */
  :global(.cmd__t) {
    font-size: var(--step--1);
    font-weight: 650;
    color: var(--text-strong);
    line-height: 1.35;
  }
  :global(.cmd__t mark) {
    background: color-mix(in srgb, var(--forge-orchid) 45%, transparent);
    color: inherit;
    border-radius: 2px;
    padding: 0 0.08em;
  }
  /* WHERE */
  :global(.cmd__w) {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent-ink);
  }
  /* WHY it matters */
  :global(.cmd__s) {
    font-size: var(--step--2);
    color: var(--text-faint);
    line-height: 1.45;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .cmd__hint {
    padding: var(--space-5);
    display: grid;
    gap: var(--space-3);
  }
  .cmd__hint[hidden] {
    display: none;
  }
  .cmd__hint-t {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .cmd__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cmd__chip {
    padding: 0.35rem 0.7rem;
    min-block-size: 2.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: var(--step--2);
    font-weight: 650;
    color: var(--text-muted);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .cmd__chip:hover {
    border-color: var(--border-strong);
    color: var(--text-strong);
  }

  .cmd__foot {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-3) var(--space-5);
    border-block-start: 1px solid var(--rule);
    font-size: var(--step--2);
    color: var(--text-faint);
  }
  .cmd__foot span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  @media (max-width: 34rem) {
    .cmd__foot {
      display: none;
    }
    .cmd {
      margin-block-start: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cmd {
      transition: none;
    }
  }
</style>

<script>
  type Entry = {
    action: string;
    title: string;
    sub: string;
    where: string;
    group: string;
    text: string;
  };

  const dialog = document.querySelector<HTMLDialogElement>('#cmd');
  const raw = document.querySelector<HTMLScriptElement>('#cmd-index');

  if (dialog && raw) {
    const entries: Entry[] = JSON.parse(raw.textContent || '[]');
    const input = dialog.querySelector<HTMLInputElement>('#cmd-input')!;
    const list = dialog.querySelector<HTMLElement>('#cmd-results')!;
    const hint = dialog.querySelector<HTMLElement>('[data-cmd-hint]')!;
    const hintTitle = dialog.querySelector<HTMLElement>('[data-cmd-hint-title]')!;
    const status = dialog.querySelector<HTMLElement>('.cmd__status')!;

    let hits: Entry[] = [];
    /** Best score per group, so the strongest match always leads. */
    let groupScore = new Map<string, number>();
    let active = 0;

    /**
     * Light stemming so "replies" finds "replying" and "creator" finds
     * "creators". Cheap suffix variants, not a real stemmer.
     */
    function variants(term: string) {
      const v = new Set([term]);
      if (term.endsWith('ies')) v.add(term.slice(0, -3) + 'y');
      if (term.endsWith('es')) v.add(term.slice(0, -2));
      if (term.endsWith('s')) v.add(term.slice(0, -1));
      if (term.length > 4) v.add(term.replace(/(ing|ed)$/, ''));
      return [...v].filter((x) => x.length > 2);
    }

    /** Title matches outrank body matches; every term must appear somewhere. */
    function score(entry: Entry, terms: string[]) {
      const title = entry.title.toLowerCase();
      let total = 0;
      for (const t of terms) {
        const forms = variants(t);
        if (!forms.some((f) => entry.text.includes(f))) return 0;
        /* Exact form scores highest, a stemmed form still counts. */
        if (title.includes(t)) total += 3;
        else if (forms.some((f) => title.includes(f))) total += 2;
        else total += 1;
        if (title.startsWith(t)) total += 2;
      }
      return total;
    }

    /** Marks the matched substrings so the reason for the hit is visible. */
    function mark(text: string, terms: string[]) {
      const frag = document.createDocumentFragment();
      const lower = text.toLowerCase();
      let i = 0;
      while (i < text.length) {
        let best = -1;
        let len = 0;
        for (const t of terms) {
          const at = lower.indexOf(t, i);
          if (at !== -1 && (best === -1 || at < best)) {
            best = at;
            len = t.length;
          }
        }
        if (best === -1) {
          frag.append(text.slice(i));
          break;
        }
        if (best > i) frag.append(text.slice(i, best));
        const em = document.createElement('mark');
        em.textContent = text.slice(best, best + len);
        frag.append(em);
        i = best + len;
      }
      return frag;
    }

    function render() {
      const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);

      const scored = terms.length
        ? entries
            .map((e) => ({ e, s: score(e, terms) }))
            .filter((x) => x.s > 0)
            .sort((a, b) => b.s - a.s)
            .slice(0, 18)
        : [];
      hits = scored.map((x) => x.e);

      active = 0;
      list.replaceChildren();

      /* Group, preserving relevance order inside each group. */
      const grouped = new Map<string, Entry[]>();
      groupScore = new Map();
      for (const { e, s } of scored) {
        if (!grouped.has(e.group)) grouped.set(e.group, []);
        grouped.get(e.group)!.push(e);
        groupScore.set(e.group, Math.max(groupScore.get(e.group) ?? 0, s));
      }
      /* Strongest group first — an exact "MOQ" hit must outrank a passing
         mention of MOQ inside a milestone deliverable. */
      const names = [...grouped.keys()].sort(
        (a, b) => (groupScore.get(b) ?? 0) - (groupScore.get(a) ?? 0)
      );

      let index = 0;
      for (const name of names) {
        const head = document.createElement('p');
        head.className = 'cmd__group';
        head.textContent = name;
        head.setAttribute('role', 'presentation');
        list.append(head);

        for (const hit of grouped.get(name)!) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'cmd__hit';
          btn.setAttribute('role', 'option');
          btn.setAttribute('aria-selected', String(index === 0));

          const t = document.createElement('span');
          t.className = 'cmd__t';
          t.append(mark(hit.title, terms));

          const w = document.createElement('span');
          w.className = 'cmd__w';
          w.textContent = hit.where;

          const s = document.createElement('span');
          s.className = 'cmd__s';
          s.textContent = hit.sub;

          btn.append(t, w, s);
          btn.addEventListener('click', () => go(hit.action));
          list.append(btn);
          index++;
        }
      }

      if (!terms.length) {
        hint.hidden = false;
        hintTitle.textContent = 'Try one of these';
      } else if (!hits.length) {
        hint.hidden = false;
        hintTitle.textContent = 'No exact match. Try:';
      } else {
        hint.hidden = true;
      }

      status.textContent = terms.length
        ? `${hits.length} result${hits.length === 1 ? '' : 's'}`
        : '';
    }

    function options() {
      return [...list.querySelectorAll<HTMLElement>('.cmd__hit')];
    }

    function highlight() {
      options().forEach((el, i) => {
        el.setAttribute('aria-selected', String(i === active));
        if (i === active) el.scrollIntoView({ block: 'nearest' });
      });
    }

    function go(action: string) {
      close();
      if (action.startsWith('open:')) {
        const drawer = (window as unknown as { byobDrawer?: { open(id: string): void } })
          .byobDrawer;
        drawer?.open(action.slice(5));
        return;
      }
      const hash = action.slice(3);
      const target = document.querySelector(hash);
      if (target instanceof HTMLDetailsElement) target.open = true;
      target?.scrollIntoView({ block: 'start' });
      /* Keep the address bar honest without triggering a second jump. */
      history.replaceState(null, '', hash);
    }

    function open() {
      if (dialog!.open) return;
      dialog!.showModal();
      document.body.classList.add('is-locked');
      input.value = '';
      render();
      input.focus();
    }

    function close() {
      if (dialog!.open) dialog!.close();
    }

    dialog.addEventListener('close', () => {
      /* The drawer may still be open underneath; don't unlock out from under it. */
      if (!document.querySelector('dialog[open]')) {
        document.body.classList.remove('is-locked');
      }
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });
    dialog.querySelector('[data-cmd-close]')!.addEventListener('click', close);
    input.addEventListener('input', render);

    input.addEventListener('keydown', (event) => {
      const opts = options();
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        active = Math.min(active + 1, opts.length - 1);
        highlight();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        active = Math.max(active - 1, 0);
        highlight();
      } else if (event.key === 'Enter') {
        event.preventDefault();
        opts[active]?.click();
      }
    });

    /* Suggestion chips run the search rather than navigating. */
    hint.addEventListener('click', (event) => {
      const chip = (event.target as HTMLElement | null)?.closest<HTMLElement>(
        '[data-suggest]'
      );
      if (!chip) return;
      input.value = chip.dataset.suggest!;
      render();
      input.focus();
    });

    document.addEventListener('click', (event) => {
      if ((event.target as HTMLElement | null)?.closest('[data-cmd-open]')) open();
    });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        dialog!.open ? close() : open();
      }
      /* "/" opens search, unless the user is typing somewhere. */
      const el = event.target as HTMLElement | null;
      const typing =
        el instanceof HTMLInputElement ||
        el instanceof HTMLTextAreaElement ||
        el?.isContentEditable;
      if (event.key === '/' && !typing && !dialog!.open) {
        event.preventDefault();
        open();
      }
    });
  }
</script>
