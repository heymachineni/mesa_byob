---
import { youTubeId } from '../lib/format';

/**
 * A video, taped into the kit. The frame is rotated a degree, double-bordered
 * (dashed pass offset behind a solid pass) and held down with tape, so it
 * reads as a photo stuck onto a page rather than an embed in a box.
 *
 * Real iframes, lazy: inside a closed panel they are never fetched at all.
 */
interface Props {
  video: { title: string; url: string; note?: string | undefined; thumb?: string | undefined; shot?: string | undefined };
}
const { video } = Astro.props;
const yt = youTubeId(video.url);
const platform = video.url.includes('instagram.com') ? 'Instagram' : 'YouTube';
---

<figure class="clip">
  {
    yt ? (
      <div class="clip__frame">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${yt}?rel=0`}
          title={video.title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        />
      </div>
    ) : video.thumb ? (
      <a class="clip__frame clip__frame--photo" href={video.url} target="_blank" rel="noopener noreferrer">
        <img class="clip__thumb" src={video.thumb} alt="" loading="lazy" />
        <span class="clip__ext clip__ext--over hand">Watch on {platform} <span class="arrow">↗</span></span>
      </a>
    ) : video.shot ? (
      <a class="clip__frame clip__frame--shot" href={video.url} target="_blank" rel="noopener noreferrer">
        <img class="clip__thumb" src={video.shot} alt="" loading="lazy" />
        <span class="clip__ext clip__ext--over hand">Open on {platform} <span class="arrow">↗</span></span>
      </a>
    ) : (
      <a class="clip__frame clip__frame--link" href={video.url} target="_blank" rel="noopener noreferrer">
        <span class="clip__ext hand">
          {platform === 'Instagram' ? 'Watch on Instagram' : 'Open'} <span class="arrow">↗</span>
        </span>
      </a>
    )
  }

  <figcaption class="clip__cap">
    <span class="clip__title">{video.title}</span>
    {video.note && <span class="clip__note">{video.note}</span>}
  </figcaption>
</figure>

<style>
  .clip {
    position: relative;
    margin: 0;
    display: grid;
    gap: var(--sp-3);
    min-inline-size: 0;
  }


  .clip__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--paper-2);
    display: block;
    text-decoration: none;
    isolation: isolate;
  }
  /* The coral pass, printed out of register. */
  .clip__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    translate: var(--shift) var(--shift);
    background: var(--coral);
    opacity: 0.22;
    transition: translate var(--base) var(--ease);
  }
  .clip:hover .clip__frame::before {
    translate: 0 0;
  }
  .clip__frame :global(iframe) {
    inline-size: 100%;
    block-size: 100%;
    border: 0;
    display: block;
  }

  .clip__frame--empty {
    display: grid;
    place-items: center;
    box-shadow: inset 0 0 0 1.5px var(--line);
  }
  /* External links have no embed to fill a 16:9 frame — an empty box that
     tall is dead space. The card hugs its one line of text instead. */
  .clip__frame--link {
    display: flex;
    align-items: center;
    aspect-ratio: auto;
    min-block-size: 0;
    padding: var(--sp-4) var(--sp-5);
    box-shadow: inset 0 0 0 1.5px var(--line);
  }
  .clip__frame--link:hover {
    background: color-mix(in srgb, var(--coral) 24%, var(--paper));
  }
  /* A reel poster: portrait crop, the link label printed over the bottom edge. */
  .clip__frame--photo {
    aspect-ratio: 4 / 5;
  }
  .clip__thumb {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }
  .clip__ext--over {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    padding: var(--sp-2) var(--sp-3);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    color: var(--ink-2);
  }
  .clip__frame--photo:hover .clip__ext--over {
    background: color-mix(in srgb, var(--coral) 24%, var(--paper));
  }
  /* An account card: both profile headers are cut to 2.8:1, so every card
     lands at the same height. */
  .clip__frame--shot {
    aspect-ratio: 2.8 / 1;
  }
  .clip__frame--shot:hover .clip__ext--over {
    background: color-mix(in srgb, var(--coral) 24%, var(--paper));
  }
  .clip__slot {
    font-size: var(--s--1);
    color: var(--text-faint);
  }
  .clip__ext {
    font-size: var(--s--1);
    font-weight: 700;
    color: var(--ink-2);
  }

  .clip__cap {
    display: grid;
    gap: 0.15rem;
    padding-inline: 0.15rem;
  }
  .clip__title {
    font-size: var(--s--1);
    font-weight: 700;
    line-height: 1.4;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .clip__src {
    font-size: var(--s--2);
    color: var(--text-faint);
  }
  .clip__note {
    font-size: var(--s-0);
    color: var(--text-soft);
  }

  /* Flat on phones: the tilt overflows a thin gutter. */
</style>
