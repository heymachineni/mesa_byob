---
/**
 * The one divider language on the site.
 *
 * number · hand-drawn rule · label
 * Title
 * Lede
 *
 * Used for every section opener so the page has a single rhythm instead of a
 * new treatment per section.
 */
interface Props {
  n?: string;
  label?: string;
  title?: string;
  lede?: string;
  as?: 'h1' | 'h2' | 'h3';
  size?: 'lg' | 'md' | 'sm';
  id?: string;
  /** Rule only — no title block. */
  bare?: boolean;
}
const {
  n,
  label,
  title,
  lede,
  as: Tag = 'h2',
  size = 'md',
  id,
  bare = false,
} = Astro.props;
---

<div class:list={['chapter', bare && 'chapter--bare']} data-reveal>
  <div class="chapter__top">
    {n && <span class="chapter__n">{n}</span>}
    <svg
      class="chapter__rule"
      viewBox="0 0 200 7"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <!-- Deliberately imperfect: the stroke drifts a little, the way a
           ruled line drawn by hand does. -->
      <path d="M0,3.7 C22,2.3 38,4.9 60,3.5 C84,2.0 102,5.1 126,3.3 C148,1.7 170,4.5 200,3.1"
      ></path>
    </svg>
    {label && <span class="chapter__label">{label}</span>}
  </div>

  {
    !bare && title && (
      <div class="chapter__head">
        <Tag id={id} class:list={['display', `display--${size}`]}>
          {title}
        </Tag>
        {lede && <p class="lede">{lede}</p>}
        <slot />
      </div>
    )
  }
</div>

<style>
  .chapter__head {
    display: grid;
    gap: var(--space-4);
    max-inline-size: var(--width-narrow);
  }
  .chapter--bare {
    margin-block-end: 0;
  }
</style>
