---
import Confirming from './Confirming.astro';
import type { Milestone, Phase, Workshop, Channel } from '../lib/content';

interface Props {
  milestone: Milestone;
  phase: Phase;
  workshops: Workshop[];
  channels: Channel[];
  seq: number;
  /** Fraction of the ₹7L target this milestone represents. */
  fraction: number;
}
const { milestone: m, phase, workshops, channels, seq, fraction } = Astro.props;
---

<article
  class="mp"
  data-panel={m.id}
  data-group="milestone"
  data-seq={seq}
  data-ctx={`${phase.name} · Week ${m.week}`}
  hidden
>
  <header class="mp__head">
    <div class="mp__tags">
      <span class="pill pill--accent">{m.code}</span>
      <span class="pill">Week {m.week}</span>
      {m.gate && <span class="pill pill--gate">{m.gate.name}</span>}
    </div>

    <h2 class="display display--md mp__title">{m.headline}</h2>

    <dl class="mp__facts">
      <div>
        <dt class="label">Deadline</dt>
        <dd>
          {
            m.dateConfirming ? (
              <Confirming note={m.dateConfirming.note}>{m.date}</Confirming>
            ) : (
              m.date
            )
          }
          <span class="mp__sub">{m.deadlineLabel}</span>
        </dd>
      </div>
      <div>
        <dt class="label">Revenue target</dt>
        <dd class="mp__rev display display--xs num">{m.revenueLabel}</dd>
      </div>
      <div>
        <dt class="label">Phase</dt>
        <dd>
          {phase.code} · {phase.name}
          <span class="mp__sub">{phase.weeks}</span>
        </dd>
      </div>
    </dl>

    <div class="mp__prog">
      <div class="mp__track">
        <span class="mp__fill" style={`--w:${(fraction * 100).toFixed(1)}%`}></span>
      </div>
      <p class="mp__prog-note">
        {Math.round(fraction * 100)}% of the ₹7 lakh minimum — the target here, not your
        team's revenue.
      </p>
    </div>
  </header>

  <div class="mp__body">
    <section class="mp__block">
      <h3 class="mp__h">What you have to submit</h3>
      <ul class="checklist">
        {m.deliverables.map((d) => <li>{d}</li>)}
      </ul>
    </section>

    {
      m.gate && (
        <section class="mp__block mp__gate">
          <div class="mp__gate-top">
            <span class="pill pill--gate">{m.gate.name}</span>
            <h3 class="mp__gate-h">The unlock</h3>
          </div>
          <p class="mp__gate-rule">
            {m.gateConfirming ? (
              <Confirming note={m.gateConfirming.note}>{m.gate.rule}</Confirming>
            ) : (
              m.gate.rule
            )}
          </p>
          {m.gate.spendOn.length > 0 && (
            <>
              <h4 class="mp__h mp__h--tight">What this tranche covers</h4>
              <ul class="mp__spend">
                {m.gate.spendOn.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </>
          )}
        </section>
      )
    }

    {
      m.escalation && (
        <section class="mp__block">
          <h3 class="mp__h">If you're behind</h3>
          <p class="callout">{m.escalation}</p>
        </section>
      )
    }

    <section class="mp__block">
      <h3 class="mp__h">What success looks like</h3>
      <blockquote class="mp__quote">
        <p class="hand">{m.mentorQuestion}</p>
        <cite>What your mentor opens with, at this week's 1:1</cite>
      </blockquote>
    </section>

    {
      (workshops.length > 0 || channels.length > 0) && (
        <section class="mp__block">
          <h3 class="mp__h">Most useful around now</h3>
          <div class="mp__links">
            {workshops.map((w) => (
              <button class="mp__chip" type="button" data-open={w.id}>
                <span class="mono">{w.code}</span>
                <span>{w.title}</span>
              </button>
            ))}
            {channels.map((c) => (
              <button class="mp__chip mp__chip--ch" type="button" data-open={c.id}>
                <span class="mono">{c.code}</span>
                <span>{c.name}</span>
              </button>
            ))}
          </div>
          <p class="mp__note">
            Workshop pairings are a reading guide for when each session helps most — check
            the program schedule for confirmed dates.
          </p>
        </section>
      )
    }
  </div>
</article>

<style>
  .mp {
    padding: var(--space-7) var(--space-6) var(--space-9);
    display: grid;
    gap: var(--space-7);
  }
  @media (max-width: 40rem) {
    .mp {
      padding: var(--space-6) var(--gutter) var(--space-8);
    }
  }

  .mp__head {
    display: grid;
    gap: var(--space-5);
  }
  .mp__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .mp__title {
    max-inline-size: 16ch;
  }

  .mp__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--rule);
  }
  .mp__facts dt {
    margin-block-end: var(--space-2);
  }
  .mp__facts dd {
    font-size: var(--step--1);
    font-weight: 650;
    color: var(--text-strong);
  }
  .mp__sub {
    display: block;
    font-size: var(--step--2);
    font-weight: 500;
    color: var(--text-faint);
  }
  .mp__rev {
    color: var(--accent-ink);
  }

  .mp__track {
    block-size: 4px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--forge-royal) 12%, transparent);
    overflow: hidden;
  }
  .mp__fill {
    display: block;
    block-size: 100%;
    inline-size: var(--w);
    background: linear-gradient(to right, var(--forge-amethyst), var(--forge-violet));
  }
  .mp__prog-note {
    font-size: var(--step--2);
    color: var(--text-faint);
    margin-block-start: var(--space-2);
  }

  .mp__body {
    display: grid;
    gap: var(--space-7);
  }
  .mp__h {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-kicker);
    color: var(--text-faint);
    font-weight: 700;
    margin-block-end: var(--space-4);
  }
  .mp__h--tight {
    margin-block: var(--space-4) var(--space-3);
  }

  .mp__gate {
    padding: var(--space-5);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--forge-violet) 6%, transparent);
    border-inline-start: 2px solid var(--forge-violet);
  }
  .mp__gate-top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-4);
    flex-wrap: wrap;
  }
  .mp__gate-h {
    font-size: var(--step-0);
    color: var(--text-strong);
  }
  .mp__gate-rule {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text-strong);
    line-height: var(--leading-body);
  }
  .mp__spend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .mp__spend li {
    font-size: var(--step--2);
    padding: 0.18rem 0.5rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--forge-royal) 8%, transparent);
    color: var(--text-muted);
  }

  .mp__quote {
    border-inline-start: 2px solid var(--forge-orchid);
    padding-inline-start: var(--space-5);
  }
  .mp__quote p {
    font-size: var(--step-2);
    line-height: 1.35;
    color: var(--text-strong);
    text-wrap: pretty;
  }
  .mp__quote cite {
    display: block;
    margin-block-start: var(--space-3);
    font-size: var(--step--2);
    font-style: normal;
    color: var(--text-faint);
  }

  .mp__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .mp__chip {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--step--2);
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    min-block-size: 2.2rem;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .mp__chip:hover {
    border-color: var(--border-strong);
    color: var(--text-strong);
  }
  .mp__chip .mono {
    color: var(--accent-ink);
    font-weight: 700;
  }
  .mp__chip--ch {
    background: color-mix(in srgb, var(--forge-orchid) 14%, transparent);
    border-color: transparent;
  }
  .mp__note {
    font-size: var(--step--2);
    color: var(--text-faint);
    margin-block-start: var(--space-4);
    line-height: var(--leading-body);
  }
</style>
