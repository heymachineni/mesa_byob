---
/**
 * The channel switcher: lateral movement across the playbook, so comparing
 * Offline with B2B is one tap instead of a round trip through the hub. Sits
 * under the header of every playbook page.
 *
 * On narrow screens the row scrolls sideways rather than wrapping into a pile,
 * and the current pill is scrolled into view on load.
 */
import { getChannels } from '../lib/content';

interface Props {
  current: string;
}
const { current } = Astro.props;
const channels = await getChannels();

const items = [
  { href: '/playbook/inventory', label: 'Inventory', num: null },
  { href: '/playbook/revenue', label: 'Revenue & Expenses', num: null },
  ...channels.map((c) => ({ href: `/playbook/${c.id}`, label: c.name, num: c.code })),
];
---

<nav class="pbn" aria-label="Playbook sections">
  <div class="pbn__scroll" data-pbn>
    {items.map((i) => (
      <a
        class:list={['pbn__pill', i.href === current && 'is-here']}
        href={i.href}
        aria-current={i.href === current ? 'page' : undefined}
      >
        {i.num && <span class="pbn__n mono">{i.num}</span>}
        {i.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .pbn {
    margin-block: var(--sp-2) var(--sp-5);
    /* Fade the clipped edge so the row reads as scrollable, not cut off. */
    position: relative;
  }
  .pbn__scroll {
    display: flex;
    gap: var(--sp-2);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-block: 0.2rem;
    /* Room so the focus ring isn't clipped by the scroll container. */
    padding-inline: 2px;
  }
  .pbn__scroll::-webkit-scrollbar { display: none; }

  .pbn__pill {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--r-btn);
    font-size: var(--s--2);
    font-weight: 600;
    color: var(--text-soft);
    text-decoration: none;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--card-line);
    white-space: nowrap;
    transition: box-shadow var(--fast) var(--ease), color var(--fast) var(--ease);
  }
  .pbn__pill:hover { color: var(--ink); box-shadow: inset 0 0 0 1px var(--coral); }
  .pbn__pill.is-here {
    color: var(--paper);
    background: var(--coral);
    box-shadow: none;
    font-weight: 700;
  }
  .pbn__n { font-size: 0.6rem; font-weight: 700; opacity: 0.75; }

  @media (prefers-reduced-motion: reduce) {
    .pbn__pill { transition: none; }
  }
</style>

<script>
  /* Bring the current pill into view when the row overflows on a phone. */
  const here = document.querySelector<HTMLElement>('.pbn .is-here');
  here?.scrollIntoView({ inline: 'center', block: 'nearest' });
</script>
