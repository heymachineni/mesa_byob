---
/**
 * Mesa lockup — rounded tile with the "m" mark plus the wordmark.
 *
 * NOTE FOR MESA: the design system references logos/mesa_logo_on_dark.png,
 * mesa_logo_on_light.png and mesa_logomark_tile.png, but those files were not
 * supplied with the brief. This is a typographic stand-in built to the written
 * spec. Drop the real assets into /public/logos and swap the markup below —
 * nothing else in the site depends on it.
 */
interface Props {
  /** Mark only, for tight spaces. */
  compact?: boolean;
  class?: string;
}
const { compact = false, class: className = '' } = Astro.props;
---

<span class:list={['logo', className]} data-compact={compact ? '' : undefined}>
  <span class="logo__tile" aria-hidden="true">m</span>
  {
    !compact && (
      <span class="logo__word">
        <span class="logo__name">Mesa</span>
        <span class="logo__sub">School of Business</span>
      </span>
    )
  }
  <span class="sr-only">Mesa School of Business</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    /* Clearance space: half the tile height on all sides, per the brand book. */
    padding: 0.375rem;
  }

  .logo__tile {
    inline-size: 1.75rem;
    block-size: 1.75rem;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border-radius: 0.5rem;
    background: var(--forge-white);
    color: var(--forge-aubergine);
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: 1.05rem;
    line-height: 1;
    padding-block-end: 0.1em;
    box-shadow: 0 1px 2px color-mix(in srgb, var(--forge-aubergine) 20%, transparent);
  }

  .logo__word {
    display: flex;
    flex-direction: column;
    line-height: 1;
    gap: 0.16rem;
  }

  .logo__name {
    font-family: var(--font-display);
    font-size: 1.06rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--text-strong);
  }

  .logo__sub {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  @media (max-width: 26rem) {
    .logo__sub {
      display: none;
    }
  }
</style>
