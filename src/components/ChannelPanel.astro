---
import VideoEmbed from './VideoEmbed.astro';
import { rupeesCompact } from '../lib/format';
import type { Channel, ChannelTarget, Milestone } from '../lib/content';

interface Props {
  channel: Channel;
  target: ChannelTarget | null;
  milestones: Milestone[];
  seq: number;
}
const { channel: c, target, milestones, seq } = Astro.props;

const essentials = [
  { label: 'How', body: c.how },
  { label: 'When', body: c.when },
  { label: 'Where', body: c.where },
  { label: 'What you need', body: c.whatYouNeed },
];
---

<article
  class="cp"
  data-panel={c.id}
  data-group="channel"
  data-seq={seq}
  data-ctx={`Channel ${c.code} · ${c.name}`}
  hidden
>
  <header class="cp__head">
    <span class="cp__code mono">{c.code}</span>
    <h2 class="display display--md">{c.name}</h2>
    <p class="cp__line">{c.oneLine}</p>

    {
      target && (
        <div class="cp__target">
          <span class="label">Your target on this channel</span>
          <div class="cp__target-row">
            {target.winRevenue !== null && (
              <span class="cp__target-big display display--sm num">
                {rupeesCompact(target.winRevenue)}
              </span>
            )}
            <ul class="cp__target-list">
              {target.tof && (
                <li>
                  <span class="cp__tag">TOF</span>
                  {target.tof}
                </li>
              )}
              {target.min.map((x) => (
                <li>
                  <span class="cp__tag">Min</span>
                  {x}
                </li>
              ))}
              {target.win.map((x) => (
                <li>
                  <span class="cp__tag cp__tag--win">Win</span>
                  {x}
                </li>
              ))}
              {target.budget && (
                <li>
                  <span class="cp__tag">Budget</span>
                  {target.budget}
                </li>
              )}
            </ul>
          </div>
          {target.note && <p class="cp__target-note">{target.note}</p>}
        </div>
      )
    }
  </header>

  <section class="cp__why">
    <h3 class="cp__h">Why this channel works for you</h3>
    <p class="cp__why-body">{c.why}</p>
  </section>

  <section class="cp__ess">
    {
      essentials.map((e) => (
        <div class="cp__ess-item">
          <h3 class="cp__ess-label">{e.label}</h3>
          <p>{e.body}</p>
        </div>
      ))
    }
  </section>

  <!-- Everything below is progressively disclosed. All source content is here;
       none of it is competing for attention at once. -->
  <div class="cp__acc">
    {
      c.gettingStarted.length > 0 && (
        <details class="acc" open>
          <summary>Getting started</summary>
          <div class="acc__body">
            <p class="cp__acc-lede">
              Have these in place before you spend a rupee or an afternoon here.
            </p>
            <ul class="checklist">
              {c.gettingStarted.map((g) => (
                <li>{g}</li>
              ))}
            </ul>
          </div>
        </details>
      )
    }

    {
      c.playbook.length > 0 && (
        <details class="acc">
          <summary>The playbook · {c.playbook.length} moves</summary>
          <div class="acc__body">
            <ol class="steps">
              {c.playbook.map((step) => (
                <li>
                  <div>
                    <h4 class="cp__step-t">{step.title}</h4>
                    <p class="cp__step-b">{step.body}</p>
                  </div>
                </li>
              ))}
            </ol>
            <p class="callout cp__good">
              <strong>What good looks like.</strong> {c.goodLooksLike}
            </p>
          </div>
        </details>
      )
    }

    {
      c.stuck.length > 0 && (
        <details class="acc">
          <summary>When you're stuck · {c.stuck.length} fixes</summary>
          <div class="acc__body">
            <ul class="cp__stuck">
              {c.stuck.map((s) => (
                <li>
                  <p class="cp__symptom hand">{s.symptom}</p>
                  <p class="cp__fix">{s.fix}</p>
                </li>
              ))}
            </ul>
          </div>
        </details>
      )
    }

    {
      c.faqs.length > 0 && (
        <details class="acc">
          <summary>Frequently asked · {c.faqs.length}</summary>
          <div class="acc__body">
            <dl class="cp__faq">
              {c.faqs.map((f) => (
                <div>
                  <dt>{f.q}</dt>
                  <dd>{f.a}</dd>
                </div>
              ))}
            </dl>
          </div>
        </details>
      )
    }

    {
      c.avoid.length > 0 && (
        <details class="acc">
          <summary>Avoid this</summary>
          <div class="acc__body">
            <ul class="avoid">
              {c.avoid.map((a) => (
                <li>{a}</li>
              ))}
            </ul>
          </div>
        </details>
      )
    }

    {
      c.videos.length > 0 && (
        <details class="acc">
          <summary>Watch & learn · {c.videos.length}</summary>
          <div class="acc__body">
            <p class="cp__acc-lede">
              General tutorials from the wider internet — not Mesa content. Useful for the
              fundamentals; adapt the specifics to your product and campus.
            </p>
            <div class="cp__videos">
              {c.videos.map((v) => (
                <VideoEmbed video={v} />
              ))}
            </div>
          </div>
        </details>
      )
    }
  </div>

  {
    milestones.length > 0 && (
      <footer class="cp__foot">
        <h3 class="cp__h">Milestones that lean on this channel</h3>
        <div class="cp__ms">
          {milestones.map((m) => (
            <button class="cp__ms-chip" type="button" data-open={m.id}>
              <span class="mono">{m.code}</span>
              <span>{m.headline}</span>
            </button>
          ))}
        </div>
      </footer>
    )
  }
</article>

<style>
  .cp {
    padding: var(--space-7) var(--space-6) var(--space-9);
    display: grid;
    gap: var(--space-7);
  }
  @media (max-width: 40rem) {
    .cp {
      padding: var(--space-6) var(--gutter) var(--space-8);
    }
  }

  .cp__head {
    display: grid;
    gap: var(--space-3);
  }
  .cp__code {
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent-ink);
  }
  .cp__line {
    font-size: var(--step-0);
    color: var(--text-muted);
    line-height: var(--leading-body);
    max-inline-size: 52ch;
    text-wrap: pretty;
  }

  .cp__target {
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--rule);
    display: grid;
    gap: var(--space-4);
  }
  .cp__target-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    align-items: start;
  }
  .cp__target-big {
    color: var(--accent-ink);
    line-height: 1;
  }
  .cp__target-list {
    display: grid;
    gap: var(--space-2);
    flex: 1 1 18rem;
  }
  .cp__target-list li {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: var(--space-3);
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.45;
  }
  .cp__tag {
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding-block-start: 0.3em;
  }
  .cp__tag--win {
    color: var(--accent-ink);
  }
  .cp__target-note {
    font-size: var(--step--2);
    color: var(--text-faint);
    font-style: italic;
  }

  .cp__h {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-kicker);
    color: var(--text-faint);
    font-weight: 700;
    margin-block-end: var(--space-4);
  }
  .cp__why-body {
    font-size: var(--step-0);
    line-height: var(--leading-loose);
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .cp__ess {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-block: 1px solid var(--rule);
  }
  .cp__ess-label {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--accent-ink);
    margin-block-end: var(--space-2);
  }
  .cp__ess-item p {
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: var(--leading-loose);
    text-wrap: pretty;
  }

  .cp__acc-lede {
    font-size: var(--step--1);
    color: var(--text-muted);
    margin-block-end: var(--space-4);
  }
  .cp__step-t {
    font-size: var(--step--1);
    color: var(--text-strong);
    margin-block-end: var(--space-2);
  }
  .cp__step-b {
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: var(--leading-loose);
    text-wrap: pretty;
  }
  .cp__good {
    margin-block-start: var(--space-6);
  }

  .cp__stuck {
    display: grid;
    gap: var(--space-5);
  }
  .cp__symptom {
    font-size: var(--step-0);
    color: var(--text-strong);
    margin-block-end: var(--space-2);
  }
  .cp__fix {
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: var(--leading-loose);
  }

  .cp__faq {
    display: grid;
    gap: var(--space-5);
  }
  .cp__faq dt {
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--text-strong);
    margin-block-end: var(--space-2);
  }
  .cp__faq dd {
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: var(--leading-loose);
  }

  .cp__videos {
    display: grid;
    gap: var(--space-5);
  }

  .cp__foot {
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--rule);
  }
  .cp__ms {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cp__ms-chip {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--step--2);
    padding: 0.35rem 0.7rem;
    min-block-size: 2.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .cp__ms-chip:hover {
    border-color: var(--border-strong);
    color: var(--text-strong);
  }
  .cp__ms-chip .mono {
    color: var(--accent-ink);
    font-weight: 700;
  }
</style>
