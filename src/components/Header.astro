---
import Logo from './Logo.astro';
import { NAV } from '../lib/content';
---

<header class="hdr" data-tone="dark" data-hdr>
  <div class="hdr__inner u-full">
    <a href="#top" class="hdr__brand">
      <Logo compact />
      <span class="hdr__kit">BYOB <span class="hdr__kit-soft">Starter Kit</span></span>
    </a>

    <nav class="hdr__nav" aria-label="Sections">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} data-nav={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr__tools">
      <button class="hdr__search" type="button" data-cmd-open>
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M13.5 13.5 L17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        <span class="hdr__search-t">Search</span>
        <kbd class="hdr__kbd">⌘K</kbd>
        <span class="sr-only">Search the starter kit</span>
      </button>

      <button
        class="hdr__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="hdr-sheet"
        aria-label="Open menu"
      >
        <span class="hdr__bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="hdr__sheet" id="hdr-sheet" hidden data-tone="dark">
    <nav aria-label="Sections, mobile">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href}>
                <span>{item.label}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href="#stuck">
            <span>When you're stuck</span><span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a href="#faq"><span>FAQ</span><span class="arrow" aria-hidden="true">→</span></a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--forge-aubergine) 82%, transparent);
    backdrop-filter: saturate(150%) blur(14px);
    -webkit-backdrop-filter: saturate(150%) blur(14px);
    border-block-end: 1px solid color-mix(in srgb, #fff 10%, transparent);
    color: var(--text);
    transition:
      background-color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  /* Stays visible, but gets quieter and shorter once you're reading. */
  .hdr[data-compact] {
    --header-h: 2.9rem;
    background: color-mix(in srgb, var(--forge-aubergine) 92%, transparent);
  }
  .hdr[data-compact] .hdr__kit-soft {
    opacity: 0;
    inline-size: 0;
    overflow: hidden;
  }

  .hdr__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-block-size: var(--header-h);
    margin-inline: auto;
    padding-inline: var(--gutter);
    transition: min-block-size var(--dur-base) var(--ease-out);
  }
  .hdr__kit-soft {
    transition:
      opacity var(--dur-base) var(--ease-out),
      inline-size var(--dur-base) var(--ease-out);
  }

  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    flex: 0 0 auto;
  }
  .hdr__kit {
    font-size: var(--step--2);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    white-space: nowrap;
  }
  .hdr__kit-soft {
    font-weight: 600;
    color: color-mix(in srgb, #fff 55%, var(--forge-aubergine));
  }

  .hdr__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 1.6vw, 1.5rem);
  }
  .hdr__nav a {
    display: inline-block;
    padding: 0.35rem 0.2rem;
    font-size: var(--step--2);
    font-weight: 650;
    color: color-mix(in srgb, #fff 68%, var(--forge-aubergine));
    text-decoration: none;
    white-space: nowrap;
    position: relative;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .hdr__nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0.2rem;
    inset-block-end: 0.05rem;
    block-size: 1.5px;
    background: var(--forge-orchid);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .hdr__nav a:hover {
    color: #fff;
  }
  .hdr__nav a:hover::after,
  .hdr__nav a.is-current::after {
    transform: scaleX(1);
  }
  .hdr__nav a.is-current {
    color: #fff;
  }

  .hdr__tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: 0 0 auto;
  }

  .hdr__search {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 0.55rem 0.35rem 0.6rem;
    min-block-size: 2.1rem;
    border: 1px solid color-mix(in srgb, #fff 18%, transparent);
    border-radius: var(--radius-pill);
    color: color-mix(in srgb, #fff 70%, var(--forge-aubergine));
    font-size: var(--step--2);
    font-weight: 650;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .hdr__search:hover {
    border-color: color-mix(in srgb, var(--forge-orchid) 55%, transparent);
    color: #fff;
  }
  .hdr__search svg {
    inline-size: 0.85rem;
    flex: 0 0 auto;
  }
  .hdr__kbd {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    padding: 0.08rem 0.28rem;
    border: 1px solid color-mix(in srgb, #fff 18%, transparent);
    border-radius: var(--radius-xs);
  }

  .hdr__toggle {
    display: none;
    inline-size: 2.4rem;
    block-size: 2.4rem;
    place-items: center;
    border-radius: var(--radius-sm);
    color: #fff;
  }
  .hdr__bars {
    display: grid;
    gap: 5px;
    inline-size: 1.05rem;
  }
  .hdr__bars span {
    display: block;
    block-size: 1.6px;
    background: currentColor;
    border-radius: 2px;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .hdr__toggle[aria-expanded='true'] .hdr__bars span:first-child {
    transform: translateY(3.3px) rotate(45deg);
  }
  .hdr__toggle[aria-expanded='true'] .hdr__bars span:last-child {
    transform: translateY(-3.3px) rotate(-45deg);
  }

  .hdr__sheet {
    display: none;
    border-block-start: 1px solid color-mix(in srgb, #fff 10%, transparent);
    background: var(--forge-aubergine);
    max-block-size: min(70dvh, 30rem);
    overflow-y: auto;
  }
  .hdr__sheet a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--gutter);
    min-block-size: 3.1rem;
    font-size: var(--step-0);
    font-weight: 650;
    color: color-mix(in srgb, #fff 82%, var(--forge-aubergine));
    text-decoration: none;
    border-block-end: 1px solid color-mix(in srgb, #fff 7%, transparent);
  }
  .hdr__sheet .arrow {
    color: var(--forge-orchid);
    opacity: 0.65;
  }

  @media (max-width: 60rem) {
    .hdr__nav {
      display: none;
    }
    .hdr__toggle {
      display: grid;
    }
    .hdr__sheet:not([hidden]) {
      display: block;
    }
    .hdr__search-t,
    .hdr__kbd {
      display: none;
    }
    .hdr__search {
      inline-size: 2.4rem;
      block-size: 2.4rem;
      justify-content: center;
      padding: 0;
    }
  }
  @media (max-width: 26rem) {
    .hdr__kit-soft {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-hdr]');
  const toggle = header?.querySelector<HTMLButtonElement>('.hdr__toggle');
  const sheet = header?.querySelector<HTMLElement>('.hdr__sheet');

  if (header && toggle && sheet) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      sheet.hidden = !open;
    };

    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true')
    );
    sheet.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 60.0625rem)').addEventListener(
      'change',
      (e) => e.matches && setOpen(false)
    );

    /* Stays put; just becomes compact once you're past the hero. Never hides,
       so "where am I?" is always answerable. */
    let ticking = false;
    const setCompact = () => {
      header.toggleAttribute('data-compact', window.scrollY > 240);
      ticking = false;
    };
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(setCompact);
      },
      { passive: true }
    );
    setCompact();
  }

  /* Marks the section currently in view in the desktop nav. */
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((a) =>
    links.set(a.dataset.nav!.slice(1), a)
  );
  const targets = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => Boolean(el));

  if (targets.length) {
    let current = '';
    const spy = new IntersectionObserver(
      (entries) => {
        const top = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!top || top.target.id === current) return;
        current = top.target.id;
        links.forEach((a, id) => a.classList.toggle('is-current', id === current));
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
    );
    targets.forEach((t) => spy.observe(t));
  }
</script>
