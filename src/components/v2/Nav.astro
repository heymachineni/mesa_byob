---
/**
 * The header: brand, menu, search.
 *
 * The menu is rendered **once** and presented twice — a row of buttons with
 * drop panels on a wide screen, a full-height accordion tree on a narrow one.
 * Two DOM trees would be two things to keep in step, and they would eventually
 * disagree.
 */
import { getMenu } from '../../lib/nav';
import Find from './Find.astro';

const menu = await getMenu();
---

<header class="bar">
  <div class="page bar__in">
    <a href="#top" class="bar__brand">
      <img class="bar__logo" src="/mesa-mark.png" alt="Mesa" width="95" height="84" />
      <span class="bar__t">BYOB</span>
    </a>

    <nav class="nav" id="nav" aria-label="Sections">
      <ul class="nav__list">
        {
          /* The label and the chevron are separate controls. One item can't be
             both "go there" and "show me what's in there" — on a touch screen
             a single tap can only mean one of them, and if tapping the label
             expanded the panel there would be no way to reach the section
             itself. So: label navigates, chevron discloses. */
          menu.map((item) => (
            <li class="nav__item">
              <div class="nav__head">
                <a
                  class="nav__btn"
                  href={item.href}
                  data-go={item.href}
                  data-spy={item.href.slice(1)}
                >
                  {item.label}
                </a>

                {item.groups && (
                  <button
                    class="nav__toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls={`np-${item.id}`}
                    data-nav-top={item.id}
                  >
                    <span class="sr-only">{`What's in ${item.label}`}</span>
                    <svg class="nav__chev" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <path
                        d="M3.5 6 8 10.5 12.5 6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="square"></path>
                    </svg>
                  </button>
                )}
              </div>

              {item.groups && (
                <div class="nav__panel" id={`np-${item.id}`} hidden>
                  <div class="nav__in">
                    {item.groups.map((g) => (
                      <div class="nav__g">
                        {g.head && <p class="nav__h">{g.head}</p>}
                        <ul class="nav__rows">
                          {g.items.map((leaf) => (
                            <li>
                              <a
                                class="nav__card"
                                href={leaf.target.startsWith('#') ? leaf.target : '#'}
                                data-go={leaf.target}
                              >
                                {leaf.num && <span class="nav__n mono">{leaf.num}</span>}
                                <span class="nav__label">{leaf.label}</span>
                                {leaf.note && <span class="nav__note">{leaf.note}</span>}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="bar__tools">
      <Find />
      <button class="bar__burger" type="button" aria-expanded="false" aria-controls="nav" data-burger>
        <span class="sr-only">Menu</span>
        <span class="bar__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Phones: a thumb-reachable marker of where you are, which opens the same
     tree. One list, two ways in — not two lists. -->
<button class="dock" type="button" data-dock aria-expanded="false" aria-controls="nav">
  <span class="dock__lead">
    <span class="dock__num mono" data-dock-num hidden></span>
    <span class="dock__label" data-dock-label>Contents</span>
  </span>
  <svg class="dock__chev" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M3.5 10.5 8 6l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"
    ></path>
  </svg>
</button>

<style>
  .bar {
    position: sticky;
    inset-block-start: 0;
    z-index: 90;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-block-end: 1px solid var(--line-soft);
  }
  .bar__in {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    min-block-size: var(--hdr-h);
  }
  /* Brand on the left, everything else pushed to the right. */
  .nav {
    margin-inline-start: auto;
  }

  .bar__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    text-decoration: none;
    flex: 0 0 auto;
  }
  /* Mesa's own mark, in place of the letter that stood in for it. Sized by
     height so the ratio comes from the file, and given explicit width/height
     attributes so it reserves its space before it loads. */
  .bar__logo {
    align-self: center;
    block-size: 1.45rem;
    inline-size: auto;
  }
  .bar__t {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink-2);
  }

  .bar__tools {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex: 0 0 auto;
  }

  .bar__burger {
    display: none;
    place-items: center;
    inline-size: 2.6rem;
    block-size: 2.6rem;
    color: var(--ink);
    cursor: pointer;
  }
  .bar__bars {
    position: relative;
    display: block;
    inline-size: 1.05rem;
    block-size: 2px;
    background: currentColor;
  }
  .bar__bars::before,
  .bar__bars::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    block-size: 2px;
    background: currentColor;
    transition:
      inset-block-start var(--fast) var(--ease),
      rotate var(--fast) var(--ease);
  }
  .bar__bars::before {
    inset-block-start: -6px;
  }
  .bar__bars::after {
    inset-block-start: 6px;
  }
  [aria-expanded='true'] .bar__bars {
    background: transparent;
  }
  [aria-expanded='true'] .bar__bars::before,
  [aria-expanded='true'] .bar__bars::after {
    inset-block-start: 0;
  }
  [aria-expanded='true'] .bar__bars::before {
    rotate: 45deg;
  }
  [aria-expanded='true'] .bar__bars::after {
    rotate: -45deg;
  }

  /* ═════════════════════════════════════════════════════════════ the menu */

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0.4rem, 1.6vw, 1.5rem);
  }
  .nav__head {
    display: flex;
    align-items: center;
  }
  .nav__btn {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.15rem;
    font-size: var(--s--2);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    text-decoration: none;
    cursor: pointer;
    transition: color var(--fast) var(--ease);
  }
  .nav__btn:hover,
  .nav__btn.is-here {
    color: var(--ink-2);
  }

  .nav__toggle {
    display: grid;
    place-items: center;
    padding: 0.5rem 0.25rem;
    color: var(--text-faint);
    cursor: pointer;
    transition: color var(--fast) var(--ease);
  }
  .nav__toggle:hover,
  .nav__toggle[aria-expanded='true'] {
    color: var(--ink-2);
  }
  /* Hovering either half lights the whole item, so it still reads as one thing
     even though it is two controls. */
  .nav__item:hover .nav__btn {
    color: var(--ink-2);
  }
  .nav__chev {
    inline-size: 0.7rem;
    block-size: 0.7rem;
    transition: rotate var(--base) var(--ease);
  }
  .nav__toggle[aria-expanded='true'] .nav__chev {
    rotate: 180deg;
  }
  /* Wide screens: the panel drops out of the bar, full width. */
  .nav__panel {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    background: var(--paper);
    border-block-end: 1px solid var(--line);
  }
  .nav__in {
    display: grid;
    gap: var(--sp-5);
    padding: var(--sp-5) var(--gutter) var(--sp-6);
    max-block-size: min(74vh, 42rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .nav__h {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--coral);
    margin-block-end: var(--sp-3);
  }
  .nav__rows {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
    gap: var(--sp-3);
  }
  /* A card, in this page's language: cream stock, a hairline, hard corners.
     The mono code takes the slot an icon would occupy. */
  .nav__card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-items: baseline;
    column-gap: 0.6rem;
    padding: var(--sp-4);
    background: var(--card);
    box-shadow: inset 0 0 0 1.4px var(--card-line);
    text-decoration: none;
    transition:
      background var(--fast) var(--ease),
      box-shadow var(--fast) var(--ease);
  }
  .nav__card:hover,
  .nav__card:focus-visible {
    background: color-mix(in srgb, var(--coral) 10%, var(--card));
    box-shadow: inset 0 0 0 1.4px var(--coral);
  }

  .nav__n {
    grid-row: 1 / span 2;
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--coral);
    padding-block-start: 0.25em;
  }
  .nav__label {
    grid-column: 2;
    font-size: var(--s--1);
    font-weight: 700;
    color: var(--ink);
    /* Long titles are Mesa's names, not copy I chose — so they wrap rather
       than getting a second, shorter name invented for them. */
    text-wrap: balance;
  }
  .nav__note {
    grid-column: 2;
    margin-block-start: 0.25rem;
    font-size: var(--s--2);
    line-height: 1.5;
    color: var(--text-soft);
    /* Two lines, whatever the source sentence does. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ══════════════════════════════════ narrow screens: one tree, full height */

  @media (max-width: 62rem) {
    .bar__burger {
      display: grid;
    }

    .nav {
      position: fixed;
      inset: var(--hdr-h) 0 0;
      z-index: 88;
      background: var(--paper);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-block-end: 6rem;
      display: none;
    }
    .nav[data-open] {
      display: block;
    }

    .nav {
      margin-inline: 0;
    }
    .nav__list {
      display: block;
      max-inline-size: var(--w-page);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }
    .nav__item + .nav__item {
      border-block-start: 1px solid var(--line-soft);
    }

    .nav__btn {
      flex: 1 1 auto;
      min-block-size: 3.4rem;
      padding-inline: 0;
      font-size: var(--s--1);
      letter-spacing: 0.04em;
      color: var(--ink);
    }
    /* A full-height target of its own, so the two meanings never share a tap. */
    .nav__toggle {
      flex: 0 0 auto;
      inline-size: 3.4rem;
      min-block-size: 3.4rem;
      margin-inline-end: -0.6rem;
      color: var(--ink-2);
    }
    .nav__chev {
      inline-size: 0.95rem;
      block-size: 0.95rem;
    }

    .nav__panel {
      position: static;
      border: 0;
      background: none;
    }
    .nav__in {
      max-block-size: none;
      overflow: visible;
      padding: 0 0 var(--sp-5);
    }
    .nav__rows {
      grid-template-columns: minmax(0, 1fr);
    }
    .nav__g + .nav__g {
      margin-block-start: var(--sp-4);
    }
    .nav__h {
      margin-block: var(--sp-3) var(--sp-2);
    }
    .nav__card {
      padding: var(--sp-3) var(--sp-4);
    }
  }

  /* ───────────────────────────────────────────── where you are, on phones */
  .dock {
    display: none;
    position: fixed;
    inset-block-end: calc(env(safe-area-inset-bottom, 0px) + 0.7rem);
    inset-inline: 0.7rem;
    z-index: 80;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    min-block-size: 3.1rem;
    padding-inline: 1rem;
    background: color-mix(in srgb, var(--paper) 96%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow:
      inset 0 0 0 1.4px var(--ink),
      3px 3px 0 color-mix(in srgb, var(--coral) 40%, var(--paper));
    cursor: pointer;
  }
  .dock__lead {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    min-inline-size: 0;
  }
  .dock__num {
    flex: 0 0 auto;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--coral);
  }
  .dock__label {
    font-size: var(--s--1);
    font-weight: 700;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dock__chev {
    flex: 0 0 auto;
    inline-size: 1.1rem;
    block-size: 1.1rem;
    color: var(--ink-2);
  }
  @media (max-width: 46rem) {
    .dock {
      display: flex;
    }
    .dock[aria-expanded='true'] {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__chev,
    .bar__bars,
    .bar__bars::before,
    .bar__bars::after {
      transition: none;
    }
  }
</style>

<script>
  import { go } from '../../lib/goto.client';

  const nav = document.getElementById('nav')!;
  const tops = [...document.querySelectorAll<HTMLButtonElement>('[data-nav-top]')];
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]')!;
  const dock = document.querySelector<HTMLButtonElement>('[data-dock]')!;
  const wide = () => !matchMedia('(max-width: 62rem)').matches;

  const panelOf = (b: HTMLButtonElement) =>
    document.getElementById(b.getAttribute('aria-controls')!)!;

  function setTop(btn: HTMLButtonElement, open: boolean) {
    btn.setAttribute('aria-expanded', String(open));
    panelOf(btn).hidden = !open;
  }

  /** One panel at a time, in both presentations. */
  function closeTops(except?: HTMLButtonElement) {
    tops.forEach((b) => b !== except && setTop(b, false));
  }

  const treeOpen = () => nav.hasAttribute('data-open');

  function setTree(open: boolean) {
    if (open) document.dispatchEvent(new CustomEvent('kit:close-find'));
    nav.toggleAttribute('data-open', open);
    burger.setAttribute('aria-expanded', String(open));
    dock.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('is-locked', open);
    if (!open) closeTops();
  }

  tops.forEach((btn) =>
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      closeTops(btn);
      setTop(btn, !open);
    })
  );

  /* A pointer that can actually hover opens the panel on approach; touch and
     coarse pointers keep click, which is the only thing they can do. The short
     delays stop a panel flashing open as the pointer crosses the bar. */
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let timer = 0;
    const after = (ms: number, fn: () => void) => {
      clearTimeout(timer);
      timer = window.setTimeout(fn, ms);
    };
    document.querySelectorAll<HTMLElement>('.nav__item').forEach((li) => {
      li.addEventListener('pointerenter', () => {
        if (!wide()) return;
        const btn = li.querySelector<HTMLButtonElement>('[data-nav-top]');
        after(110, () => {
          closeTops(btn ?? undefined);
          if (btn) setTop(btn, true);
        });
      });
    });
    /* The panel is a descendant of .nav, so moving down into it doesn't leave. */
    nav.addEventListener('pointerenter', () => clearTimeout(timer));
    nav.addEventListener('pointerleave', () => {
      if (wide()) after(260, () => closeTops());
    });
  }

  burger.addEventListener('click', () => setTree(!treeOpen()));
  document.addEventListener('kit:close-menu', () => setTree(false));
  dock.addEventListener('click', () => setTree(true));

  /* Every destination goes through the same opener as search, so a link to a
     milestone opens its panel and a link into a fold opens the fold. */
  document.querySelectorAll<HTMLAnchorElement>('.nav [data-go]').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (!go(a.dataset.go!)) return;
      e.preventDefault();
      closeTops();
      if (!wide()) setTree(false);
    })
  );

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (treeOpen()) {
      setTree(false);
      burger.focus();
      return;
    }
    const open = tops.find((b) => b.getAttribute('aria-expanded') === 'true');
    if (open) {
      setTop(open, false);
      open.focus();
    }
  });

  /* A click outside a wide-screen drop panel closes it. The full-height tree
     has its own control and shouldn't vanish on a stray tap. */
  document.addEventListener('click', (e) => {
    if (!wide()) return;
    if (!(e.target as HTMLElement).closest('.nav, [data-burger]')) closeTops();
  });

  /* Panels are laid out for one presentation or the other; leaving one open
     across the boundary strands it. */
  matchMedia('(max-width: 62rem)').addEventListener('change', () => {
    closeTops();
    setTree(false);
  });

  /* ── where you are ───────────────────────────────────────────────────── */
  const STOPS: Array<[string, string, string]> = [
    ['brief', '01', 'Overview'],
    ['climb', '02', 'The climb'],
    ['weeks', '03', 'Milestones'],
    ['selling', '04', 'Channels'],
    ['workshops', '05', 'Workshops'],
    ['money', '06', 'Revenue'],
    ['breaks', '07', 'Help'],
    ['flea', '08', 'Flea'],
    ['faq', '09', 'FAQ'],
  ];
  const num = document.querySelector<HTMLElement>('[data-dock-num]')!;
  const label = document.querySelector<HTMLElement>('[data-dock-label]')!;
  const targets = STOPS.map(([id]) => document.getElementById(id)).filter(
    (el): el is HTMLElement => Boolean(el)
  );

  if (targets.length) {
    let at = -1;
    const live = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) live.add(e.target.id);
          else live.delete(e.target.id);
        });
        const next = STOPS.findIndex(([id]) => live.has(id));
        if (next === at) return;
        at = next;
        const stop = STOPS[at];
        num.textContent = stop ? stop[1] : '';
        num.toggleAttribute('hidden', !stop);
        label.textContent = stop ? stop[2] : 'Contents';
        document
          .querySelectorAll<HTMLElement>('[data-spy]')
          .forEach((a) => a.classList.toggle('is-here', !!stop && a.dataset.spy === stop[0]));
      },
      { rootMargin: '-18% 0px -70% 0px' }
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
