---
/**
 * The header: brand, menu, search.
 *
 * The menu is rendered **once** and presented twice — a row of buttons with
 * drop panels on a wide screen, a full-height accordion tree on a narrow one.
 * Two DOM trees would be two things to keep in step, and they would eventually
 * disagree.
 */
import { getMenu } from '../../lib/nav';
import Find from './Find.astro';

const menu = await getMenu();
---

<header class="bar">
  <div class="page bar__in">
    <a href="#top" class="bar__brand">
      <span class="bar__m" aria-hidden="true">m</span>
      <span class="bar__t">BYOB</span>
    </a>

    <nav class="nav" id="nav" aria-label="Sections">
      <ul class="nav__list">
        {
          menu.map((item) =>
            item.groups ? (
              <li class="nav__item">
                <button
                  class="nav__btn"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`np-${item.id}`}
                  data-top={item.id}
                >
                  <span>{item.label}</span>
                  <svg class="nav__chev" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path
                      d="M3.5 6 8 10.5 12.5 6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="square"></path>
                  </svg>
                </button>

                <div class="nav__panel" id={`np-${item.id}`} hidden>
                  <div class:list={['page', 'nav__in', item.split && 'nav__in--split']}>
                    {item.groups.map((g) => (
                      <div class="nav__g">
                        {g.head && <p class="nav__h">{g.head}</p>}
                        <ul class="nav__rows">
                          {g.items.map((leaf) => (
                            <li>
                              <a
                                class="nav__row"
                                href={leaf.target.startsWith('#') ? leaf.target : '#'}
                                data-go={leaf.target}
                              >
                                {leaf.num && <span class="nav__n mono">{leaf.num}</span>}
                                <span class="nav__label">{leaf.label}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </li>
            ) : (
              /* No panel, so it navigates. The affordance says so: an arrow,
                 not a chevron. */
              <li class="nav__item">
                <a class="nav__btn" href={item.href} data-go={item.href} data-spy={item.href.slice(1)}>
                  <span>{item.label}</span>
                  <span class="nav__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <div class="bar__tools">
      <Find />
      <button class="bar__burger" type="button" aria-expanded="false" aria-controls="nav" data-burger>
        <span class="sr-only">Menu</span>
        <span class="bar__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Phones: a thumb-reachable marker of where you are, which opens the same
     tree. One list, two ways in — not two lists. -->
<button class="dock" type="button" data-dock aria-expanded="false" aria-controls="nav">
  <span class="dock__lead">
    <span class="dock__num mono" data-dock-num hidden></span>
    <span class="dock__label" data-dock-label>Contents</span>
  </span>
  <svg class="dock__chev" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M3.5 10.5 8 6l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"
    ></path>
  </svg>
</button>

<style>
  .bar {
    position: sticky;
    inset-block-start: 0;
    z-index: 90;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-block-end: 1px solid var(--line-soft);
  }
  .bar__in {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    min-block-size: var(--hdr-h);
  }

  .bar__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    text-decoration: none;
    flex: 0 0 auto;
  }
  .bar__m {
    align-self: center;
    display: grid;
    place-items: center;
    inline-size: 1.4rem;
    block-size: 1.4rem;
    background: var(--ink);
    color: var(--paper);
    font-weight: 800;
    font-size: 0.8rem;
    line-height: 1;
    padding-block-end: 0.06em;
  }
  .bar__t {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink-2);
  }

  .bar__tools {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-inline-start: auto;
    flex: 0 0 auto;
  }

  .bar__burger {
    display: none;
    place-items: center;
    inline-size: 2.6rem;
    block-size: 2.6rem;
    color: var(--ink);
    cursor: pointer;
  }
  .bar__bars,
  .bar__bars::before,
  .bar__bars::after {
    display: block;
    inline-size: 1.05rem;
    block-size: 2px;
    background: currentColor;
    transition:
      translate var(--fast) var(--ease),
      rotate var(--fast) var(--ease);
  }
  .bar__bars::before,
  .bar__bars::after {
    content: '';
    position: relative;
  }
  .bar__bars::before {
    inset-block-start: -6px;
  }
  .bar__bars::after {
    inset-block-start: 4px;
  }
  [aria-expanded='true'] .bar__bars {
    background: transparent;
  }
  [aria-expanded='true'] .bar__bars::before {
    translate: 0 6px;
    rotate: 45deg;
  }
  [aria-expanded='true'] .bar__bars::after {
    translate: 0 -4px;
    rotate: -45deg;
  }

  /* ═════════════════════════════════════════════════════════════ the menu */

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0.1rem, 1vw, 0.7rem);
  }
  .nav__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.45rem 0.5rem;
    font-size: var(--s--2);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
    text-decoration: none;
    cursor: pointer;
    transition: color var(--fast) var(--ease);
  }
  .nav__btn:hover,
  .nav__btn.is-here,
  .nav__btn[aria-expanded='true'] {
    color: var(--ink-2);
  }
  .nav__chev {
    inline-size: 0.7rem;
    block-size: 0.7rem;
    transition: rotate var(--base) var(--ease);
  }
  .nav__btn[aria-expanded='true'] .nav__chev {
    rotate: 180deg;
  }
  .nav__arrow {
    font-size: 0.85em;
  }

  /* Wide screens: the panel drops out of the bar, full width. */
  .nav__panel {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    background: var(--paper);
    border-block-end: 1px solid var(--line);
  }
  .nav__in {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: var(--sp-5) var(--sp-7);
    padding-block: var(--sp-6);
    align-items: start;
  }
  /* Thirteen workshops in one column is a scroll; two halves the height. */
  .nav__in--split .nav__rows {
    columns: 2;
    column-gap: var(--sp-7);
  }
  .nav__in--split li {
    break-inside: avoid;
  }

  .nav__h {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--coral);
    margin-block-end: var(--sp-3);
  }
  .nav__rows {
    display: grid;
    gap: 0.1rem;
  }
  .nav__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.42rem 0.5rem;
    margin-inline: -0.5rem;
    font-size: var(--s--1);
    color: var(--text-soft);
    text-decoration: none;
    transition:
      background var(--fast) var(--ease),
      color var(--fast) var(--ease);
  }
  .nav__row:hover,
  .nav__row:focus-visible {
    background: color-mix(in srgb, var(--coral) 12%, transparent);
    color: var(--ink);
  }
  .nav__n {
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--coral);
  }
  /* Long titles are Mesa's names, not copy I chose — so they truncate rather
     than getting a second, shorter name invented for them. */
  .nav__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ══════════════════════════════════ narrow screens: one tree, full height */

  @media (max-width: 62rem) {
    .bar__burger {
      display: grid;
    }

    .nav {
      position: fixed;
      inset: var(--hdr-h) 0 0;
      z-index: 88;
      background: var(--paper);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-block-end: 6rem;
      display: none;
    }
    .nav[data-open] {
      display: block;
    }

    .nav__list {
      display: block;
      max-inline-size: var(--w-page);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }
    .nav__item + .nav__item {
      border-block-start: 1px solid var(--line-soft);
    }

    .nav__btn {
      inline-size: 100%;
      justify-content: space-between;
      min-block-size: 3.4rem;
      padding-inline: 0;
      font-size: var(--s--1);
      letter-spacing: 0.04em;
      color: var(--ink);
    }
    .nav__chev {
      inline-size: 0.95rem;
      block-size: 0.95rem;
    }

    .nav__panel {
      position: static;
      border: 0;
      background: none;
    }
    .nav__in {
      display: block;
      max-inline-size: none;
      margin-inline: 0;
      padding: 0 0 var(--sp-5);
    }
    .nav__in--split .nav__rows {
      columns: 1;
    }
    .nav__g + .nav__g {
      margin-block-start: var(--sp-4);
    }
    .nav__h {
      margin-block: var(--sp-3) var(--sp-2);
    }
    .nav__row {
      min-block-size: 2.9rem;
      align-items: center;
      padding-inline: 0.6rem;
      margin-inline: -0.6rem;
    }
  }

  /* ───────────────────────────────────────────── where you are, on phones */
  .dock {
    display: none;
    position: fixed;
    inset-block-end: calc(env(safe-area-inset-bottom, 0px) + 0.7rem);
    inset-inline: 0.7rem;
    z-index: 80;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    min-block-size: 3.1rem;
    padding-inline: 1rem;
    background: color-mix(in srgb, var(--paper) 96%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow:
      inset 0 0 0 1.4px var(--ink),
      3px 3px 0 color-mix(in srgb, var(--coral) 40%, var(--paper));
    cursor: pointer;
  }
  .dock__lead {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    min-inline-size: 0;
  }
  .dock__num {
    flex: 0 0 auto;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--coral);
  }
  .dock__label {
    font-size: var(--s--1);
    font-weight: 700;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dock__chev {
    flex: 0 0 auto;
    inline-size: 1.1rem;
    block-size: 1.1rem;
    color: var(--ink-2);
  }
  @media (max-width: 46rem) {
    .dock {
      display: flex;
    }
    .dock[aria-expanded='true'] {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__chev,
    .bar__bars,
    .bar__bars::before,
    .bar__bars::after {
      transition: none;
    }
  }
</style>

<script>
  import { go } from '../../lib/goto.client';

  const nav = document.getElementById('nav')!;
  const tops = [...document.querySelectorAll<HTMLButtonElement>('[data-top]')];
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]')!;
  const dock = document.querySelector<HTMLButtonElement>('[data-dock]')!;
  const wide = () => !matchMedia('(max-width: 62rem)').matches;

  const panelOf = (b: HTMLButtonElement) =>
    document.getElementById(b.getAttribute('aria-controls')!)!;

  function setTop(btn: HTMLButtonElement, open: boolean) {
    btn.setAttribute('aria-expanded', String(open));
    panelOf(btn).hidden = !open;
  }

  /** One panel at a time, in both presentations. */
  function closeTops(except?: HTMLButtonElement) {
    tops.forEach((b) => b !== except && setTop(b, false));
  }

  const treeOpen = () => nav.hasAttribute('data-open');

  function setTree(open: boolean) {
    if (open) document.dispatchEvent(new CustomEvent('kit:close-find'));
    nav.toggleAttribute('data-open', open);
    burger.setAttribute('aria-expanded', String(open));
    dock.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('is-locked', open);
    if (!open) closeTops();
  }

  tops.forEach((btn) =>
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      closeTops(btn);
      setTop(btn, !open);
    })
  );

  burger.addEventListener('click', () => setTree(!treeOpen()));
  document.addEventListener('kit:close-menu', () => setTree(false));
  dock.addEventListener('click', () => setTree(true));

  /* Every destination goes through the same opener as search, so a link to a
     milestone opens its panel and a link into a fold opens the fold. */
  document.querySelectorAll<HTMLAnchorElement>('.nav [data-go]').forEach((a) =>
    a.addEventListener('click', (e) => {
      if (!go(a.dataset.go!)) return;
      e.preventDefault();
      closeTops();
      if (!wide()) setTree(false);
    })
  );

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (treeOpen()) {
      setTree(false);
      burger.focus();
      return;
    }
    const open = tops.find((b) => b.getAttribute('aria-expanded') === 'true');
    if (open) {
      setTop(open, false);
      open.focus();
    }
  });

  /* A click outside a wide-screen drop panel closes it. The full-height tree
     has its own control and shouldn't vanish on a stray tap. */
  document.addEventListener('click', (e) => {
    if (!wide()) return;
    if (!(e.target as HTMLElement).closest('.nav, [data-burger]')) closeTops();
  });

  /* Panels are laid out for one presentation or the other; leaving one open
     across the boundary strands it. */
  matchMedia('(max-width: 62rem)').addEventListener('change', () => {
    closeTops();
    setTree(false);
  });

  /* ── where you are ───────────────────────────────────────────────────── */
  const STOPS: Array<[string, string, string]> = [
    ['brief', '01', 'The brief'],
    ['climb', '02', 'Revenue ladder'],
    ['weeks', '03', 'Milestones'],
    ['selling', '04', 'Channels'],
    ['sessions', '05', 'Workshops'],
    ['money', '06', 'Money'],
    ['breaks', '07', 'Troubleshooting'],
    ['flea', '08', 'Flea'],
    ['asked', '09', 'Questions'],
  ];
  const num = document.querySelector<HTMLElement>('[data-dock-num]')!;
  const label = document.querySelector<HTMLElement>('[data-dock-label]')!;
  const targets = STOPS.map(([id]) => document.getElementById(id)).filter(
    (el): el is HTMLElement => Boolean(el)
  );

  if (targets.length) {
    let at = -1;
    const live = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) live.add(e.target.id);
          else live.delete(e.target.id);
        });
        const next = STOPS.findIndex(([id]) => live.has(id));
        if (next === at) return;
        at = next;
        const stop = STOPS[at];
        num.textContent = stop ? stop[1] : '';
        num.toggleAttribute('hidden', !stop);
        label.textContent = stop ? stop[2] : 'Contents';
        document
          .querySelectorAll<HTMLElement>('[data-spy]')
          .forEach((a) => a.classList.toggle('is-here', !!stop && a.dataset.spy === stop[0]));
      },
      { rootMargin: '-18% 0px -70% 0px' }
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
