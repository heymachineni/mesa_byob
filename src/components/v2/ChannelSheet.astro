---
import Clip from './Clip.astro';
import { rupeesCompact } from '../../lib/format';
import type { Channel, ChannelTarget, Milestone } from '../../lib/content';

interface Props {
  c: Channel;
  target: ChannelTarget | null;
  milestones: Milestone[];
  seq: number;
}
const { c, target, milestones, seq } = Astro.props;

const four = [
  { l: 'How', b: c.how },
  { l: 'When', b: c.when },
  { l: 'Where', b: c.where },
  { l: 'What you need', b: c.whatYouNeed },
];
---

<article
  class="ch"
  data-panel={c.id}
  data-group="channel"
  data-seq={seq}
  data-where={`channel ${c.code} · ${c.name}`}
  hidden
>
  <header class="ch__top">
    <span class="ch__code mono">{c.code}</span>
    <h2 class="disp disp--md">{c.name}</h2>
    <p class="ch__line say">{c.oneLine}</p>

    {
      target && (
        <div class="ch__target">
          <p class="kicker">Your target here</p>
          <div class="ch__trow">
            {target.winRevenue !== null && (
              <span class="ch__big disp disp--sm num">{rupeesCompact(target.winRevenue)}</span>
            )}
            <ul class="ch__tlist">
              {target.tof && (
                <li>
                  <span class="ch__tag">TOF</span>
                  {target.tof}
                </li>
              )}
              {target.min.map((x) => (
                <li>
                  <span class="ch__tag">Min</span>
                  {x}
                </li>
              ))}
              {target.win.map((x) => (
                <li>
                  <span class="ch__tag ch__tag--win">Win</span>
                  {x}
                </li>
              ))}
              {target.budget && (
                <li>
                  <span class="ch__tag">Budget</span>
                  {target.budget}
                </li>
              )}
            </ul>
          </div>
          {target.note && <p class="ch__tnote">{target.note}</p>}
        </div>
      )
    }
  </header>

  <section class="ch__why">
    <h3 class="ch__h">Why this one works</h3>
    <p class="ch__whyb">{c.why}</p>
  </section>

  <section class="ch__four">
    {
      four.map((f, i) => (
        <div class="ch__f" style={`--tilt:${i % 2 ? 0.6 : -0.6}deg`}>
          <h3 class="ch__fl">{f.l}</h3>
          <p>{f.b}</p>
        </div>
      ))
    }
  </section>

  <div class="ch__folds">
    {
      c.gettingStarted.length > 0 && (
        <details class="fold" open>
          <summary>Before you start</summary>
          <div class="fold__body">
            <p class="ch__lede">Have these in place before you spend a rupee or an afternoon.</p>
            <ul class="ticks">
              {c.gettingStarted.map((g) => (
                <li>{g}</li>
              ))}
            </ul>
          </div>
        </details>
      )
    }

    {
      c.playbook.length > 0 && (
        <details class="fold">
          <summary>The playbook · {c.playbook.length} moves</summary>
          <div class="fold__body">
            <ol class="steps">
              {c.playbook.map((s) => (
                <li>
                  <div>
                    <h4 class="ch__st">{s.title}</h4>
                    <p class="ch__sb">{s.body}</p>
                  </div>
                </li>
              ))}
            </ol>
            <p class="aside ch__good">
              <strong>What good looks like.</strong> {c.goodLooksLike}
            </p>
          </div>
        </details>
      )
    }

    {
      c.stuck.length > 0 && (
        <details class="fold">
          <summary>When you're stuck · {c.stuck.length} fixes</summary>
          <div class="fold__body">
            <ul class="ch__stuck">
              {c.stuck.map((s) => (
                <li>
                  <p class="ch__sym say">{s.symptom}</p>
                  <p class="ch__fix">{s.fix}</p>
                </li>
              ))}
            </ul>
          </div>
        </details>
      )
    }

    {
      c.faqs.length > 0 && (
        <details class="fold">
          <summary>Questions people ask · {c.faqs.length}</summary>
          <div class="fold__body">
            <dl class="ch__faq">
              {c.faqs.map((f) => (
                <div>
                  <dt>{f.q}</dt>
                  <dd>{f.a}</dd>
                </div>
              ))}
            </dl>
          </div>
        </details>
      )
    }

    {
      c.avoid.length > 0 && (
        <details class="fold">
          <summary>Don't do this</summary>
          <div class="fold__body">
            <ul class="nope">
              {c.avoid.map((a) => (
                <li>{a}</li>
              ))}
            </ul>
          </div>
        </details>
      )
    }

    {
      c.videos.length > 0 && (
        <details class="fold">
          <summary>Watch & learn · {c.videos.length}</summary>
          <div class="fold__body">
            <p class="ch__lede">
              General tutorials from the wider internet — not Mesa content. Good for the
              fundamentals; adapt the specifics to your product and campus.
            </p>
            <div class="ch__vids">
              {c.videos.map((v, i) => (
                <Clip video={v} />
              ))}
            </div>
          </div>
        </details>
      )
    }
  </div>

  {
    milestones.length > 0 && (
      <footer class="ch__foot">
        <h3 class="ch__h">Milestones that lean on this</h3>
        <div class="ch__ms">
          {milestones.map((m) => (
            <button class="ch__mschip" type="button" data-open={m.id}>
              <span class="mono">{m.code}</span>
              <span>{m.headline}</span>
            </button>
          ))}
        </div>
      </footer>
    )
  }
</article>

<style>
  .ch {
    display: grid;
    gap: var(--sp-6);
    padding: var(--sp-7) var(--sp-6) var(--sp-9);
  }
  @media (max-width: 40rem) {
    .ch {
      padding: var(--sp-5) var(--gutter) var(--sp-8);
    }
  }

  .ch__top {
    display: grid;
    gap: var(--sp-2);
  }
  .ch__code {
    font-size: var(--s-0);
    font-weight: 800;
    color: var(--violet);
  }
  .ch__line {
    font-size: var(--s-2);
    color: var(--text-soft);
    max-inline-size: 34ch;
  }

  .ch__target {
    position: relative;
    margin-block-start: var(--sp-4);
    padding: var(--sp-5);
    background: var(--paper-2);
    border: 1.6px solid var(--ink);
    border-radius: 18px 190px 15px 175px / 175px 14px 165px 16px;
    display: grid;
    gap: var(--sp-3);
  }
  .ch__target :global(.ch__clip) {
    position: absolute;
    inset-block-start: -1.5rem;
    inset-inline-end: 1.5rem;
  }
  .ch__trow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4) var(--sp-5);
    align-items: start;
  }
  .ch__big {
    color: var(--violet);
    line-height: 1;
  }
  .ch__tlist {
    display: grid;
    gap: var(--sp-2);
    flex: 1 1 17rem;
  }
  .ch__tlist li {
    display: grid;
    grid-template-columns: 2.7rem 1fr;
    gap: var(--sp-3);
    font-size: var(--s--1);
    color: var(--text-soft);
    line-height: 1.5;
  }
  .ch__tag {
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding-block-start: 0.32em;
    white-space: nowrap;
  }
  .ch__tag--win {
    color: var(--violet);
  }
  .ch__tnote {
    font-size: var(--s-0);
    color: var(--text-faint);
  }

  .ch__h {
    font-size: 1.45rem;
    color: var(--ink-2);
    margin-block-end: var(--sp-3);
  }
  .ch__whyb {
    font-size: var(--s-0);
    line-height: 1.78;
    color: var(--text-soft);
    text-wrap: pretty;
  }

  .ch__four {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
    gap: var(--sp-4);
  }
  .ch__f {
    padding: var(--sp-4);
    background: var(--paper);
    border: 1.5px dashed var(--line);
    rotate: var(--tilt);
    transition: rotate var(--fast) var(--ease);
  }
  .ch__f:hover {
  }
  .ch__fl {
    font-family: var(--font-hand);
    font-size: 1.28rem;
    color: var(--violet);
    margin-block-end: var(--sp-2);
  }
  .ch__f p {
    font-size: var(--s--1);
    line-height: 1.7;
    color: var(--text-soft);
    text-wrap: pretty;
  }

  .ch__lede {
    font-size: var(--s--1);
    color: var(--text-soft);
    margin-block-end: var(--sp-4);
  }
  .ch__st {
    font-size: var(--s--1);
    font-weight: 800;
    color: var(--ink-2);
    margin-block-end: var(--sp-2);
  }
  .ch__sb {
    font-size: var(--s--1);
    line-height: 1.72;
    color: var(--text-soft);
    text-wrap: pretty;
  }
  .ch__good {
    margin-block-start: var(--sp-5);
  }

  .ch__stuck {
    display: grid;
    gap: var(--sp-5);
  }
  .ch__sym {
    font-size: var(--s-1);
    color: var(--ink-2);
    margin-block-end: var(--sp-2);
  }
  .ch__fix {
    font-size: var(--s--1);
    line-height: 1.72;
    color: var(--text-soft);
  }

  .ch__faq {
    display: grid;
    gap: var(--sp-5);
  }
  .ch__faq dt {
    font-size: var(--s--1);
    font-weight: 800;
    color: var(--ink-2);
    margin-block-end: var(--sp-2);
  }
  .ch__faq dd {
    font-size: var(--s--1);
    line-height: 1.72;
    color: var(--text-soft);
  }

  .ch__vids {
    display: grid;
    gap: var(--sp-6);
  }

  .ch__foot {
    padding-block-start: var(--sp-5);
    border-block-start: 1.5px dashed var(--line);
  }
  .ch__ms {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .ch__mschip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    min-block-size: 2.2rem;
    font-size: var(--s--2);
    color: var(--text-soft);
    border: 1.5px solid var(--line);
    border-radius: 70px 9px 65px 10px / 10px 60px 9px 70px;
    transition:
      rotate var(--fast) var(--ease),
      border-color var(--fast) var(--ease);
  }
  .ch__mschip:nth-child(even) {
  }
  .ch__mschip:hover {
    border-color: var(--ink);
  }
  .ch__mschip .mono {
    font-weight: 800;
    color: var(--violet);
  }
</style>
