---
/**
 * The shell every page shares: top bar, the left index on wide screens, the
 * bottom dock on narrow ones, and a prev/next footer so the kit reads as a
 * sequence, not a pile.
 *
 * The rail is the whole wayfinding model. Every page is listed, all at one
 * small size, and the one you are on is semibold with a short marker line:
 * position is always visible, never announced.
 */
import '../styles/v2/riso.css';
import Find from '../components/Find.astro';
import { PAGES, prevNext } from '../lib/nav';

interface Props {
  title: string;
  description: string;
  current: string;
}
const { title, description, current } = Astro.props;
const { prev, next } = prevNext(current);
const groups = [...new Set(PAGES.map((p) => p.group))];
const here = PAGES.find((p) => p.href === current);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · BYOB Starter Kit</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0e21" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="180x180" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preload" href="/fonts/newyork-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-variable.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="bar">
      <div class="bar__in">
        <a href="/" class="bar__brand">
          <img class="bar__logo" src="/mesa-mark-on-dark.png" alt="Mesa" width="96" height="96" />
          <span class="bar__t">BYOB</span>
          <span class="bar__s">Starter Kit</span>
        </a>
        <div class="bar__tools">
          <Find />
        </div>
      </div>
    </header>

    <div class="shell">
      <nav class="rail" aria-label="Pages">
        {groups.map((g) => (
          <div class="rail__g">
            <p class="rail__h">{g}</p>
            <ul>
              {PAGES.filter((p) => p.group === g).map((p) => (
                <li>
                  <a
                    class:list={['rail__a', p.href === current && 'is-here']}
                    href={p.href}
                    aria-current={p.href === current ? 'page' : undefined}
                  >{p.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <a class="rail__out" href="/api/auth/logout">Sign out</a>
      </nav>

      <main id="main" class="content">
        <slot />

        <nav class="turn" aria-label="Continue">
          {prev ? (
            <a class="turn__a" href={prev.href}>
              <span class="turn__k">Previous</span>
              <span class="turn__t">{prev.label}</span>
            </a>
          ) : <span></span>}
          {next && (
            <a class="turn__a turn__a--next" href={next.href}>
              <span class="turn__k">Next</span>
              <span class="turn__t">{next.label}</span>
            </a>
          )}
        </nav>

        <footer class="foot">
          <p>BYOB Starter Kit · Mesa School of Business · PGP Forge</p>
        </footer>
      </main>
    </div>

    <!-- Narrow screens: where you are, and one tap to the full list. -->
    <button class="dock" type="button" aria-expanded="false" aria-controls="sheet" data-dock-open>
      <span class="dock__label">{here?.label ?? 'Pages'}</span>
      <svg class="dock__chev" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M3.5 10.5 8 6l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
      </svg>
    </button>

    <div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="Pages">
      <div class="sheet__scrim" data-dock-close></div>
      <div class="sheet__panel">
        <div class="sheet__grab" aria-hidden="true"></div>
        <header class="sheet__head">
          <p class="sheet__title">Pages</p>
          <button class="sheet__x" type="button" data-dock-close>
            <span class="sr-only">Close</span>
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
          </button>
        </header>
        <nav aria-label="All pages">
        {groups.map((g) => (
          <div class="sheet__g">
            <p class="rail__h">{g}</p>
            <ul>
              {PAGES.filter((p) => p.group === g).map((p) => (
                <li>
                  <a
                    class:list={['sheet__a', p.href === current && 'is-here']}
                    href={p.href}
                    aria-current={p.href === current ? 'page' : undefined}
                  >{p.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        </nav>
        <a class="sheet__out" href="/api/auth/logout">Sign out</a>
      </div>
    </div>

    <style>
      .skip {
        position: absolute;
        inset-inline-start: 1rem;
        transform: translateY(-160%);
        z-index: 200;
        background: var(--coral);
        color: var(--paper);
        padding: 0.7rem 1.2rem;
        border-radius: var(--r-sm);
        font-weight: 700;
        transition: transform var(--fast) var(--ease);
      }
      .skip:focus-visible { transform: translateY(0.5rem); }

      /* ── top bar ──────────────────────────────────────────────────────── */
      .bar {
        position: sticky;
        inset-block-start: 0;
        z-index: 90;
        background: color-mix(in srgb, var(--paper) 98%, transparent);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
      }
      .bar__in {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-4);
        max-inline-size: var(--w-shell);
        margin-inline: auto;
        padding-inline: var(--gutter);
        min-block-size: var(--hdr-h);
      }
      .bar__brand { display: inline-flex; align-items: baseline; gap: 0.5rem; text-decoration: none; }
      .bar__logo { align-self: center; block-size: 1.6rem; inline-size: auto; }
      .bar__t { font-family: var(--font-display); font-size: 1.15rem; color: var(--ink-2); }
      .bar__s {
        font-size: var(--s--2);
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-faint);
      }
      .bar__tools { display: flex; align-items: center; gap: var(--sp-2); }

      /* ── the shell: rail plus content ─────────────────────────────────── */
      .shell {
        display: grid;
        grid-template-columns: 15rem minmax(0, 1fr);
        gap: var(--sp-8);
        max-inline-size: var(--w-shell);
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      .rail {
        position: sticky;
        inset-block-start: calc(var(--hdr-h) + 1.5rem);
        align-self: start;
        max-block-size: calc(100dvh - var(--hdr-h) - 3rem);
        overflow-y: auto;
        padding-block: var(--sp-6) var(--sp-4);
        scrollbar-width: thin;
      }
      .rail__g + .rail__g { margin-block-start: var(--sp-5); }
      .rail__h {
        font-family: var(--font-mono);
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--text-faint);
        margin-block-end: var(--sp-2);
      }
      .rail__a {
        position: relative;
        display: block;
        padding: 0.32rem 0 0.32rem 0.9rem;
        font-size: var(--s--1);
        color: var(--text-soft);
        text-decoration: none;
        transition: color var(--fast) var(--ease);
      }
      .rail__a::before {
        content: '';
        position: absolute;
        inset-inline-start: 0;
        inset-block: 0.55rem;
        inline-size: 2px;
        border-radius: 1px;
        background: transparent;
        transition: background var(--fast) var(--ease);
      }
      .rail__a:hover { color: var(--ink); }
      .rail__a.is-here { color: var(--ink); font-weight: 600; }
      .rail__a.is-here::before { background: var(--coral); }
      .rail__out {
        display: inline-block;
        margin-block-start: var(--sp-6);
        font-size: var(--s--2);
        color: var(--text-faint);
        text-decoration: none;
      }
      .rail__out:hover { color: var(--coral); }

      .content { padding-block: var(--sp-7) var(--sp-8); min-inline-size: 0; }

      /* ── prev/next ────────────────────────────────────────────────────── */
      .turn {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--sp-4);
        margin-block-start: var(--sp-8);
        padding-block-start: var(--sp-6);
        border-block-start: 1px solid var(--line-soft);
      }
      .turn__a {
        display: grid;
        gap: 0.2rem;
        padding: var(--sp-4);
        border-radius: var(--r-card);
        background: var(--card);
        box-shadow: inset 0 0 0 1.4px var(--card-line);
        text-decoration: none;
        transition: box-shadow var(--fast) var(--ease);
      }
      .turn__a:hover { box-shadow: inset 0 0 0 1.4px var(--coral); }
      .turn__a--next { text-align: end; }
      .turn__k {
        font-family: var(--font-mono);
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--text-faint);
      }
      /* Clamped so a long label ("Revenue & Expenses") stays on one line on a
         phone instead of wrapping the card tall. */
      .turn__t {
        font-family: var(--font-display);
        font-size: clamp(1rem, 0.8rem + 1vw, 1.3rem);
        color: var(--ink-2);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .foot {
        margin-block-start: var(--sp-7);
        font-size: var(--s--2);
        color: var(--text-faint);
      }

      /* ── narrow screens ───────────────────────────────────────────────── */
      @media (max-width: 64rem) {
        .shell { display: block; }
        .rail { display: none; }
        .bar__s { display: none; }
        body { padding-block-end: 5.5rem; }
        .content { padding-block-start: var(--sp-5); }
        .turn { grid-template-columns: 1fr 1fr; gap: var(--sp-3); }
        .turn__a { padding: var(--sp-3) var(--sp-4); }
      }

      .dock {
        display: none;
        position: fixed;
        inset-block-end: calc(env(safe-area-inset-bottom, 0px) + 0.7rem);
        inset-inline: 0.9rem;
        z-index: 80;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-3);
        min-block-size: 3.1rem;
        padding-inline: 1.1rem;
        border-radius: var(--r-btn);
        background: color-mix(in srgb, var(--paper) 96%, transparent);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow:
          inset 0 0 0 1.4px var(--ink),
          3px 3px 0 color-mix(in srgb, var(--coral) 40%, var(--paper));
        cursor: pointer;
        transition: transform 160ms var(--ease-out);
      }
      .dock:active { transform: scale(0.97); }
      @media (max-width: 64rem) { .dock { display: flex; } }
      .dock__label { font-size: var(--s--1); font-weight: 700; color: var(--ink); }
      .dock__chev { inline-size: 1.05rem; block-size: 1.05rem; color: var(--ink-2); }

      /* Closed by default; [data-open] slides it up. visibility waits for the
         exit transition, so the sheet leaves the way it arrived instead of
         vanishing mid-slide. */
      .sheet {
        position: fixed; inset: 0; z-index: 95;
        visibility: hidden;
        transition: visibility 0s 500ms;
      }
      .sheet[data-open] { visibility: visible; transition: visibility 0s; }
      .sheet__scrim {
        position: absolute; inset: 0;
        background: color-mix(in srgb, #000 55%, transparent);
        opacity: 0;
        transition: opacity 250ms var(--ease-out);
      }
      .sheet[data-open] .sheet__scrim { opacity: 1; }
      .sheet__panel {
        transform: translateY(100%);
        transition: transform 500ms var(--ease-drawer);
        position: absolute;
        inset-inline: 0;
        inset-block-end: 0;
        max-block-size: 84dvh;
        display: flex;
        flex-direction: column;
        padding: var(--sp-2) var(--sp-5) calc(var(--sp-4) + env(safe-area-inset-bottom, 0px));
        border-start-start-radius: var(--r-card);
        border-start-end-radius: var(--r-card);
        background: var(--paper-2);
      }
      .sheet[data-open] .sheet__panel { transform: translateY(0); }

      .sheet__grab {
        inline-size: 2.25rem;
        block-size: 0.25rem;
        border-radius: 999px;
        background: var(--line);
        margin: 0.35rem auto var(--sp-2);
        flex: 0 0 auto;
      }
      .sheet__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block-end: var(--sp-2);
        border-block-end: 1px solid var(--line-soft);
        margin-block-end: var(--sp-3);
        flex: 0 0 auto;
      }
      .sheet__title {
        font-family: var(--font-display);
        font-size: var(--s-0);
        color: var(--ink-2);
      }
      .sheet__x {
        display: grid;
        place-items: center;
        inline-size: 2.75rem;
        block-size: 2.75rem;
        margin-inline-end: -0.6rem;
        border-radius: var(--r-sm);
        color: var(--ink);
        cursor: pointer;
      }
      .sheet__x svg { inline-size: 1rem; block-size: 1rem; }
      .sheet__panel nav {
        overflow-y: auto;
        overscroll-behavior: contain;
        min-block-size: 0;
      }
      .sheet__g + .sheet__g { margin-block-start: var(--sp-5); }
      .sheet__a {
        position: relative;
        display: flex;
        align-items: center;
        min-block-size: 2.75rem;
        padding: 0.35rem 0.2rem 0.35rem 0.9rem;
        font-size: var(--s--1);
        color: var(--text-soft);
        text-decoration: none;
        border-radius: var(--r-sm);
      }
      .sheet__a::before {
        content: '';
        position: absolute;
        inset-inline-start: 0;
        inset-block: 0.7rem;
        inline-size: 2px;
        border-radius: 1px;
        background: transparent;
      }
      .sheet__a.is-here { color: var(--ink); font-weight: 600; }
      .sheet__a.is-here::before { background: var(--coral); }
      .sheet__out {
        display: flex;
        align-items: center;
        min-block-size: 2.75rem;
        margin-block-start: var(--sp-3);
        padding-block-start: var(--sp-2);
        border-block-start: 1px solid var(--line-soft);
        font-size: var(--s--2);
        color: var(--text-faint);
        text-decoration: none;
        flex: 0 0 auto;
      }

      @media (prefers-reduced-motion: reduce) {
        .skip, .rail__a, .turn__a { transition: none; }
        .sheet__panel { transition: none; }
        .sheet { transition: none; }
      }
    </style>

    <script>
      import { onArrival } from '../lib/goto.client';
      onArrival();
      addEventListener('hashchange', onArrival);

      /* Section reveal: the direct children of main are the blocks — headers,
         sections, asides — so copy animates as passages, never as paragraphs.
         Blocks already in the first viewport stagger 50ms; everything below
         reveals as it approaches. Skipped entirely when arriving on a hash,
         so a deep link never makes its target fade in late. */
      if (!location.hash && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const blocks = [...document.querySelectorAll<HTMLElement>('#main > *:not(.turn):not(.foot)')];
        let early = 0;
        for (const b of blocks) {
          b.classList.add('rvl');
          if (b.getBoundingClientRect().top < innerHeight) {
            b.style.setProperty('--rvl-d', `${Math.min(early++, 5) * 50}ms`);
          }
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('rvl-in');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' }
        );
        blocks.forEach((b) => io.observe(b));
      }

      const sheet = document.getElementById('sheet')!;
      const openers = [...document.querySelectorAll<HTMLButtonElement>('[data-dock-open]')];
      let opener: HTMLElement | null = null;
      const set = (open: boolean) => {
        sheet.toggleAttribute('data-open', open);
        document.body.classList.toggle('is-locked', open);
        openers.forEach((b) => b.setAttribute('aria-expanded', String(open)));
        if (open) {
          opener = document.activeElement as HTMLElement;
          sheet.querySelector<HTMLElement>('.sheet__x')?.focus();
        } else {
          opener?.focus();
        }
      };
      /* Keep Tab inside the open sheet — it is a modal, so focus is too. */
      sheet.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab') return;
        const f = [...sheet.querySelectorAll<HTMLElement>('button, a[href]')].filter(
          (el) => el.offsetParent !== null
        );
        if (!f.length) return;
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { last.focus(); e.preventDefault(); }
        else if (!e.shiftKey && document.activeElement === last) { first.focus(); e.preventDefault(); }
      });
      openers.forEach((b) => b.addEventListener('click', () => set(!sheet.hasAttribute('data-open'))));
      sheet.querySelector('[data-dock-close]')!.addEventListener('click', () => set(false));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && sheet.hasAttribute('data-open')) set(false);
      });
    </script>
  </body>
</html>
