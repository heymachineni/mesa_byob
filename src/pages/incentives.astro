---
/** Incentives & rewards: first-to-hit and sustained-performance awards
 *  that sit alongside the formal grade. */
import Kit from '../layouts/Kit.astro';
import { getIncentives } from '../lib/content';

export const prerender = false;
const inc = await getIncentives();
---

<Kit title="Incentives" description={inc.intro} current="/incentives">
  <header class="ph">
    <p class="kicker">{inc.kicker}</p>
    <h1 class="disp disp--lg">{inc.title}</h1>
    <p class="lede">{inc.intro}</p>
  </header>

  <div class="groups">
    {inc.groups.map((g, i) => (
      <section class="group card" aria-labelledby={`inc-${i}`}>
        <header class="group__h">
          <h2 class="group__t" id={`inc-${i}`}>{g.name}</h2>
          {g.tagline && <p class="group__tag">{g.tagline}</p>}
        </header>
        <table class="awards">
          <caption class="sr-only">{g.name}: achievements and rewards</caption>
          <thead><tr><th scope="col">Achievement</th><th scope="col">Reward</th></tr></thead>
          <tbody>
            {g.awards.map((a) => (
              <tr><td>{a.achievement}</td><td class="awards__r">{a.reward}</td></tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}
  </div>

  {inc.play && inc.play.length > 0 && (
    <section class="play card" aria-labelledby="inc-play">
      <h2 class="group__t" id="inc-play">{inc.playTitle}</h2>
      <ul class="play__l">
        {inc.play.map((p) => <li>{p}</li>)}
      </ul>
    </section>
  )}

  {inc.note && <p class="aside aside--violet">{inc.note}</p>}
</Kit>

<style>
  .ph { display: grid; gap: var(--sp-3); padding-block-end: var(--sp-6); }
  .lede { max-inline-size: 58ch; }
  .groups { display: grid; gap: var(--sp-4); }
  .card { padding: var(--sp-5); border-radius: var(--r-card); background: var(--card); box-shadow: inset 0 0 0 1.4px var(--card-line); }
  .group { display: grid; gap: var(--sp-4); }
  .group__h { display: grid; gap: var(--sp-1); }
  .group__t { font-family: var(--font-display); font-size: var(--s-2); color: var(--ink-2); }
  .group__tag { font-size: var(--s--1); color: var(--text-soft); }

  .awards { border-collapse: collapse; inline-size: 100%; }
  .awards th, .awards td { text-align: start; padding: 0.65rem 1rem 0.65rem 0; border-block-end: 1px solid var(--line-soft); font-size: var(--s--1); line-height: 1.6; }
  .awards tbody tr:last-child td { border-block-end: 0; padding-block-end: 0; }
  .awards th { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-faint); }
  .awards td { color: var(--text-soft); }
  .awards__r { color: var(--coral); font-weight: 700; }

  .play { display: grid; gap: var(--sp-3); margin-block-start: var(--sp-4); }
  .play__l { display: grid; gap: var(--sp-2); padding-inline-start: 1.1rem; }
  .play__l li { font-size: var(--s--1); line-height: 1.7; color: var(--text-soft); max-inline-size: 66ch; }

  .aside--violet { margin-block-start: var(--sp-5); }
</style>
