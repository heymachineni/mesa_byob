---
/** Incentives: what top teams earn beyond the grade. Content lands when the
 *  programme team announces it — until then the page says so honestly. */
import Kit from '../layouts/Kit.astro';
import { getIncentives } from '../lib/content';

export const prerender = false;
const inc = await getIncentives();
---

<Kit title="Incentives" description={inc.intro} current="/incentives">
  <header class="ph">
    <p class="kicker">{inc.kicker}</p>
    <h1 class="disp disp--lg">{inc.title}</h1>
    <p class="lede">{inc.intro}</p>
  </header>

  {inc.items.length > 0 ? (
    <ul class="grid2">
      {inc.items.map((it) => (
        <li class="card">
          <h2 class="card__t">{it.title}</h2>
          <p class="card__b">{it.body}</p>
        </li>
      ))}
    </ul>
  ) : (
    inc.note && <p class="aside aside--violet">{inc.note}</p>
  )}

  {inc.items.length > 0 && inc.note && <p class="aside">{inc.note}</p>}
</Kit>

<style>
  .ph { display: grid; gap: var(--sp-3); padding-block-end: var(--sp-6); }
  .lede { max-inline-size: 58ch; }
  .grid2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    gap: var(--sp-4);
  }
  .card {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    padding: var(--sp-5);
    border-radius: var(--r-card);
    background: var(--card);
    box-shadow: inset 0 0 0 1.4px var(--card-line);
  }
  .card__t { font-family: var(--font-display); font-size: var(--s-1); color: var(--ink-2); }
  .card__b { font-size: var(--s--1); line-height: 1.7; color: var(--text-soft); }
</style>
