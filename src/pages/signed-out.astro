---
/**
 * Where a failed or ended sign-in lands. Reachable without a session, so it
 * cannot itself send you back to the gate.
 */
export const prerender = false;

const REASONS: Record<string, string> = {
  not_allowed: 'That Google account isn’t on the Mesa domain. Sign in with your Mesa address.',
  signed_out: 'You’re signed out.',
  state_mismatch: 'That sign-in link had expired. Try again.',
  bad_request: 'That sign-in link was incomplete. Try again.',
  token_exchange: 'Google couldn’t complete the sign-in. Try again.',
  no_id_token: 'Google didn’t return an identity. Try again.',
  wrong_audience: 'That sign-in was issued for a different app.',
  access_denied: 'Sign-in was cancelled.',
};
const reason = Astro.url.searchParams.get('reason') ?? '';
const message = REASONS[reason] ?? 'You need to sign in to open the kit.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in — BYOB Starter Kit</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <style>
      :root { color-scheme: dark; }
      body {
        margin: 0; min-block-size: 100dvh; display: grid; place-items: center;
        padding: 2rem; background: #0d0e21; color: #fbf7f0;
        font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif;
      }
      .box { max-inline-size: 26rem; text-align: center; }
      img { inline-size: 3rem; block-size: 3rem; margin-block-end: 1.5rem; }
      h1 { font-size: 1.5rem; font-weight: 700; margin: 0 0 0.6rem; }
      p { color: #b9b6c4; line-height: 1.6; margin: 0 0 1.8rem; }
      a {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.8rem 1.4rem; border-radius: 1rem;
        background: #b1a6f6; color: #0d0e21;
        font-weight: 700; text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class="box">
      <img src="/favicon.png" alt="Mesa" width="96" height="96" />
      <h1>BYOB Starter Kit</h1>
      <p>{message}</p>
      <a href="/api/auth/login">Sign in with Google</a>
    </div>
  </body>
</html>
