---
/** Thirteen workshops, in order, with what to expect from each. */
import Kit from '../layouts/Kit.astro';
import { getWorkshops } from '../lib/content';

export const prerender = false;
const workshops = await getWorkshops();
---

<Kit title="Workshops" description="The thirteen BYOB workshops and what to expect from each." current="/workshops">
  <header class="ph">
    <p class="kicker">Workshops</p>
    <h1 class="disp disp--lg">Thirteen workshops, timed to the work.</h1>
    <p class="lede">Each workshop lands when you need it. Come with your numbers and leave with your next move.</p>
  </header>

  <ol class="ws">
    {workshops.map((w) => (
      <li class="ws__row card" id={w.id}>
        <span class="ws__n mono">{w.code}</span>
        <div>
          <h2 class="ws__t">{w.title}</h2>
          <p class="ws__e">{w.expect}</p>
        </div>
      </li>
    ))}
  </ol>
</Kit>

<style>
  .ph { display: grid; gap: var(--sp-3); padding-block-end: var(--sp-6); }
  .lede { max-inline-size: 56ch; }
  .ws { display: grid; gap: var(--sp-3); }
  .card {
    border-radius: var(--r-card);
    background: var(--card);
    box-shadow: inset 0 0 0 1.4px var(--card-line);
    scroll-margin-block-start: calc(var(--hdr-h) + 1rem);
  }
  .ws__row { display: grid; grid-template-columns: 3.4rem 1fr; gap: var(--sp-4); padding: var(--sp-4) var(--sp-5); }
  .ws__n { font-size: var(--s--2); font-weight: 700; color: var(--coral); padding-block-start: 0.3em; }
  .ws__t { font-family: var(--font-display); font-size: var(--s-1); color: var(--ink-2); }
  .ws__e { font-size: var(--s--1); line-height: 1.7; color: var(--text-soft); margin-block-start: 0.3rem; }
</style>
