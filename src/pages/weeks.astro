---
/** The weekly 1:1: what your mentor will ask, week by week. */
import Kit from '../layouts/Kit.astro';
import { getWeekly } from '../lib/content';

export const prerender = false;
const weekly = await getWeekly();
---

<Kit title="Weekly Check-ins" description="What your weekly 1:1 mentor check-in focuses on, week by week." current="/weeks">
  <header class="ph">
    <p class="kicker">Weekly Check-ins</p>
    <h1 class="disp disp--lg">One question that matters, every week.</h1>
    <p class="lede">Your weekly 1:1 with your mentor tracks the milestone you're inside. This is what each check-in focuses on.</p>
  </header>

  <ol class="wk">
    {weekly.map((w) => (
      <li class="wk__row card" id={w.id}>
        <span class="wk__w mono">{w.week}</span>
        <span class="wk__m">{w.milestone}</span>
        <p class="wk__f">{w.focus}</p>
      </li>
    ))}
  </ol>
</Kit>

<style>
  .ph { display: grid; gap: var(--sp-3); padding-block-end: var(--sp-6); }
  .lede { max-inline-size: 56ch; }
  .wk { display: grid; gap: var(--sp-3); }
  .card {
    border-radius: var(--r-card);
    background: var(--card);
    box-shadow: inset 0 0 0 1.4px var(--card-line);
    scroll-margin-block-start: calc(var(--hdr-h) + 1rem);
  }
  .wk__row {
    display: grid;
    grid-template-columns: 3.2rem minmax(7rem, auto) 1fr;
    gap: var(--sp-4);
    align-items: baseline;
    padding: var(--sp-4) var(--sp-5);
  }
  .wk__w { font-size: var(--s--2); font-weight: 700; color: var(--coral); }
  .wk__m { font-family: var(--font-display); font-size: var(--s-0); color: var(--ink-2); white-space: nowrap; }
  .wk__f { font-size: var(--s--1); line-height: 1.7; color: var(--text-soft); }
  @media (max-width: 40rem) {
    .wk__row { grid-template-columns: 3.2rem 1fr; }
    .wk__f { grid-column: 2; }
  }
</style>
