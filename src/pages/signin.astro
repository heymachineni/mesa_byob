---
/**
 * Sign in.
 *
 * One action, and everything else in service of it. There is no email field:
 * an earlier version had one to pass Google a `login_hint`, but a field that
 * looks like a login form and isn't one costs more than the tap it saves.
 *
 * Self-contained on purpose — it borrows no stylesheet or component from the
 * kit, because it is the page that has to render when something else is broken.
 * Colours and type are Forge's own, read from its stylesheet.
 */
export const prerender = false;

import { env } from '../lib/auth';

const domains = (env('ALLOWED_EMAIL_DOMAINS') || 'mesaschool.co')
  .split(',')
  .map((d) => d.trim())
  .filter(Boolean);

const reason = Astro.url.searchParams.get('reason') ?? '';
const next = Astro.url.searchParams.get('next') ?? '/';
const safeNext = next.startsWith('/') && !next.startsWith('//') ? next : '/';

/** What happened, and what to do about it. Never just "an error occurred". */
const NOTES: Record<string, { warn?: boolean; title: string; body: string; retry?: boolean }> = {
  not_allowed: {
    warn: true,
    title: 'That’s not a Mesa account',
    body: 'Sign-in worked, but that address isn’t one of the two below.',
    retry: true,
  },
  unverified: {
    warn: true,
    title: 'That address isn’t verified',
    body: 'Google hasn’t verified the email on that account.',
    retry: true,
  },
  access_denied: { title: 'Sign-in cancelled', body: 'Nothing happened — try again when you’re ready.' },
  state_mismatch: { title: 'That link had expired', body: 'Sign-in links are short-lived.' },
  bad_request: { title: 'That sign-in was incomplete', body: 'Something was missing on the way back.' },
  token_exchange: { warn: true, title: 'Google couldn’t finish', body: 'Wait a moment and try again.' },
  no_id_token: { warn: true, title: 'Google didn’t return an identity', body: 'This usually clears on a second attempt.' },
  wrong_audience: { warn: true, title: 'That sign-in was for a different app', body: 'Start from this page, not an old link.' },
  signed_out: { title: 'You’re signed out', body: 'Sign in again whenever you need the kit.' },
};

/* What Google actually said, when it said anything. These are configuration
   faults, not student mistakes — telling someone to "try again" when the app's
   own credentials are wrong wastes their time and hides the real problem. */
const DETAIL: Record<string, string> = {
  invalid_client:
    'The app’s Google credentials are wrong or missing. This is a setup problem on our side, not yours.',
  redirect_uri_mismatch:
    'This deployment’s address isn’t registered with Google. A setup problem on our side.',
  invalid_grant:
    'That sign-in link had already been used. Start again from this page.',
  unauthorized_client:
    'This app isn’t authorised for that sign-in method. A setup problem on our side.',
};
const detail = DETAIL[Astro.url.searchParams.get('detail') ?? ''];

const note = NOTES[reason];

/* After a rejected account Google signs the same one straight back in, and the
   student loops through a rejection they can't escape. */
const href =
  `/api/auth/login?next=${encodeURIComponent(safeNext)}` +
  (note?.retry ? '&prompt=select_account' : '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in — BYOB Starter Kit</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0d0e21" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="180x180" />
    <link rel="preload" href="/fonts/manrope-variable.woff2" as="font" type="font/woff2" crossorigin />

    <style is:inline>
      /* Forge's own two faces: `--body-font: "Manrope"`, `--cursive-font:
         "New York Large"`. Self-hosted, subset, same files as the kit. */
      @font-face {
        font-family: 'Manrope';
        src: url('/fonts/manrope-variable.woff2') format('woff2-variations');
        font-weight: 200 800;
        font-display: swap;
      }
      @font-face {
        font-family: 'New York';
        src: url('/fonts/newyork-regular.woff2') format('woff2');
        font-weight: 400 700;
        font-display: swap;
      }

      :root {
        color-scheme: dark;

        /* Forge, read from its stylesheet rather than sampled from a picture. */
        --navy: #0d0e21;
        --panel: #161738;
        --deep: #1e0f51;
        --indigo: #444aa5;
        --peri: #b1a6f6;
        --ink: #fbf7f0;
        --soft: #9d9bb0;
        --edge: rgba(255, 255, 255, 0.15);

        /* One spacing scale, 8px-based. Every gap on this page is a step on it;
           nothing is eyeballed, which is most of why a layout reads as calm. */
        --s0: 0.25rem;
        --s1: 0.5rem;
        --s2: 0.75rem;
        --s3: 1rem;
        --s4: 1.5rem;
        --s5: 2rem;
        --s6: 2.5rem;
        --s7: 3.5rem;

        /* And one type ramp. */
        --t-title: clamp(1.5rem, 1.3rem + 1vw, 1.75rem);
        --t-body: 0.9375rem;
        --t-fine: 0.8125rem;

        --ease: cubic-bezier(0.32, 0.72, 0, 1);
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }

      body {
        min-block-size: 100dvh;
        display: grid;
        place-items: center;
        padding: var(--s4);
        padding-block-start: max(var(--s4), env(safe-area-inset-top));
        padding-block-end: max(var(--s4), env(safe-area-inset-bottom));
        color: var(--ink);
        font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif;
        font-size: var(--t-body);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;

        background:
          radial-gradient(120% 75% at 15% 0%, var(--deep) 0%, transparent 60%),
          radial-gradient(90% 75% at 88% 100%, rgba(68, 74, 165, 0.55) 0%, transparent 55%),
          var(--navy);
        background-attachment: fixed;
      }

      /* Narrow on purpose. A sign-in card wants one short measure so the eye
         goes straight down the middle — widening it only spreads three lines. */
      .card {
        inline-size: 100%;
        max-inline-size: 21rem;
        padding: var(--s6) var(--s5) var(--s5);
        border: 1px solid var(--edge);
        border-radius: 1rem;
        background: var(--panel);
        box-shadow: 0 32px 64px -32px rgba(0, 0, 0, 0.8);
        text-align: center;
      }
      @media (min-width: 30rem) {
        .card { padding: var(--s7) var(--s6) var(--s6); }
      }

      /* Rise once, quietly. Motion here is a courtesy, not an effect. */
      @media (prefers-reduced-motion: no-preference) {
        .card {
          animation: rise 0.5s var(--ease) both;
        }
        @keyframes rise {
          from { opacity: 0; transform: translateY(8px); }
        }
      }

      .mark {
        inline-size: 2.5rem;
        block-size: 2.5rem;
        display: block;
        margin: 0 auto var(--s4);
      }

      h1 {
        font-family: 'New York', Georgia, serif;
        font-size: var(--t-title);
        font-weight: 400;
        line-height: 1.2;
        letter-spacing: -0.01em;
        margin: 0;
      }
      .lede {
        margin: var(--s1) 0 0;
        color: var(--soft);
        text-wrap: balance;
      }

      /* What went wrong, if anything. Tinted rather than boxed — it should read
         as a remark above the button, not a second component. */
      .note {
        margin-block-start: var(--s4);
        padding: var(--s2) var(--s3);
        border-radius: 0.75rem;
        text-align: start;
        background: rgba(177, 166, 246, 0.1);
      }
      .note--warn { background: rgba(255, 173, 128, 0.11); }
      .note b {
        display: block;
        font-size: var(--t-fine);
        font-weight: 700;
        letter-spacing: 0.01em;
      }
      .note span {
        display: block;
        margin-block-start: var(--s0);
        font-size: var(--t-fine);
        line-height: 1.5;
        color: var(--soft);
      }

      /* The one action. Filled, because on a page with a single thing to do the
         primary control should not be asking permission. Forge's periwinkle on
         its navy is 8.76:1. */
      .go {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--s2);
        inline-size: 100%;
        min-block-size: 3rem;
        margin-block-start: var(--s5);
        border-radius: 1rem;
        background: var(--peri);
        color: var(--navy);
        font-size: var(--t-body);
        font-weight: 700;
        text-decoration: none;
        transition:
          filter 0.2s var(--ease),
          transform 0.2s var(--ease);
      }
      .go:hover { filter: brightness(1.07); }
      /* A press should feel like one. */
      .go:active { transform: scale(0.985); }
      .go svg { inline-size: 1.125rem; block-size: 1.125rem; flex: 0 0 auto; }

      :focus-visible {
        outline: 2px solid var(--peri);
        outline-offset: 3px;
        border-radius: 1rem;
      }

      .fine {
        margin: var(--s4) 0 0;
        font-size: var(--t-fine);
        line-height: 1.55;
        color: var(--soft);
        text-wrap: balance;
      }
      .fine b { color: var(--ink); font-weight: 600; white-space: nowrap; }

      /* Hairline, then the way out. Separated so it reads as a footnote to the
         card rather than another option competing with the button. */
      .out {
        margin: var(--s5) 0 0;
        padding-block-start: var(--s4);
        border-block-start: 1px solid rgba(255, 255, 255, 0.08);
        font-size: var(--t-fine);
      }
      .out a {
        color: var(--soft);
        text-decoration: none;
        transition: color 0.2s var(--ease);
      }
      .out a:hover { color: var(--peri); }

      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
    </style>
  </head>

  <body>
    <main class="card">
      <img class="mark" src="/favicon.png" alt="Mesa" width="96" height="96" />

      <h1>BYOB Starter Kit</h1>
      <p class="lede">Sign in to open it.</p>

      {
        note && (
          <div class:list={['note', note.warn && 'note--warn']} role="alert">
            <b>{note.title}</b>
            <span>{detail ?? note.body}</span>
          </div>
        )
      }

      <a class="go" href={href}>
        <svg viewBox="0 0 18 18" aria-hidden="true" focusable="false">
          <path fill="#4285F4" d="M17.6 9.2c0-.6-.1-1.3-.2-1.8H9v3.5h4.8a4.1 4.1 0 0 1-1.8 2.7v2.2h2.9c1.7-1.6 2.7-3.9 2.7-6.6z"/>
          <path fill="#34A853" d="M9 18c2.4 0 4.5-.8 6-2.2l-2.9-2.2c-.8.5-1.8.9-3.1.9-2.4 0-4.4-1.6-5.1-3.8H.9v2.3A9 9 0 0 0 9 18z"/>
          <path fill="#FBBC05" d="M3.9 10.7a5.4 5.4 0 0 1 0-3.4V5H.9a9 9 0 0 0 0 8l3-2.3z"/>
          <path fill="#EA4335" d="M9 3.6c1.3 0 2.5.5 3.4 1.3l2.6-2.6A9 9 0 0 0 .9 5l3 2.3C4.6 5.2 6.6 3.6 9 3.6z"/>
        </svg>
        {note?.retry ? 'Try a different account' : 'Continue with Google'}
      </a>

      <p class="fine">
        For {domains.map((d, i) => (<>{i > 0 && ' and '}<b>@{d}</b></>))} accounts.
      </p>

      <p class="out"><a href="https://mesaschool.co/" rel="noopener">mesaschool.co</a></p>
    </main>
  </body>
</html>
