---
/**
 * Sign in.
 *
 * One action. An earlier version put an email field above the button so the
 * address could be passed to Google as a `login_hint` — it saved a tap for
 * anyone with two Google accounts, and cost everyone else a moment of "I've
 * typed my name, now what?". A field that looks like a login form but isn't one
 * is worse than no field, so it is gone. Google asks who you are anyway.
 *
 * Self-contained on purpose: it borrows no stylesheet or component from the
 * kit, because it is the page that has to render when something else is broken.
 * Colours, fonts and both control shapes are Forge's own, read from its
 * stylesheet rather than approximated.
 */
export const prerender = false;

import { env } from '../lib/auth';

const domains = (env('ALLOWED_EMAIL_DOMAINS') || 'mesaschool.co')
  .split(',')
  .map((d) => d.trim())
  .filter(Boolean);

const reason = Astro.url.searchParams.get('reason') ?? '';
const next = Astro.url.searchParams.get('next') ?? '/';
const safeNext = next.startsWith('/') && !next.startsWith('//') ? next : '/';

/** What happened, and what to do about it. Never just "an error occurred". */
const NOTES: Record<string, { warn?: boolean; title: string; body: string; retry?: boolean }> = {
  not_allowed: {
    warn: true,
    title: 'That’s not a Mesa account',
    body: `Sign-in worked, but that address isn’t on ${domains.map((d) => '@' + d).join(' or ')}.`,
    retry: true,
  },
  unverified: {
    warn: true,
    title: 'That address isn’t verified',
    body: 'Google hasn’t verified the email on that account. Verify it, then come back.',
    retry: true,
  },
  access_denied: {
    title: 'Sign-in cancelled',
    body: 'Nothing happened. Try again whenever you’re ready.',
  },
  state_mismatch: {
    title: 'That link had expired',
    body: 'Sign-in links are short-lived. Starting again takes a second.',
  },
  bad_request: {
    title: 'That sign-in was incomplete',
    body: 'Something was missing on the way back from Google.',
  },
  token_exchange: {
    warn: true,
    title: 'Google couldn’t finish',
    body: 'It didn’t complete on Google’s side. Wait a moment and try again.',
  },
  no_id_token: {
    warn: true,
    title: 'Google didn’t return an identity',
    body: 'That usually clears on a second attempt.',
  },
  wrong_audience: {
    warn: true,
    title: 'That sign-in was for a different app',
    body: 'Start from this page rather than an old link or bookmark.',
  },
  signed_out: {
    title: 'You’re signed out',
    body: 'Sign in again whenever you need the kit.',
  },
};

const note = NOTES[reason];

/* After a rejected account Google would sign the same one straight back in, and
   the student would loop through a rejection they can't escape. */
const href =
  `/api/auth/login?next=${encodeURIComponent(safeNext)}` +
  (note?.retry ? '&prompt=select_account' : '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in — BYOB Starter Kit</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0d0e21" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="180x180" />
    <link rel="preload" href="/fonts/manrope-variable.woff2" as="font" type="font/woff2" crossorigin />

    <style is:inline>
      /* Forge's own two faces: `--body-font: "Manrope"` and
         `--cursive-font: "New York Large"`, self-hosted here. */
      @font-face {
        font-family: 'Manrope';
        src: url('/fonts/manrope-variable.woff2') format('woff2-variations');
        font-weight: 200 800;
        font-display: swap;
      }
      @font-face {
        font-family: 'New York';
        src: url('/fonts/newyork-regular.woff2') format('woff2');
        font-weight: 400 700;
        font-display: swap;
      }

      :root {
        color-scheme: dark;
        /* Read from Forge's stylesheet, not sampled from a screenshot. */
        --navy: #0d0e21; /* html, body background */
        --panel: #161738; /* its card background */
        --edge: rgba(255, 255, 255, 0.15); /* its card border */
        --peri: #b1a6f6; /* its CTA colour */
        --indigo: #444aa5;
        --deep: #1e0f51; /* --bs-heading-color */
        --ink: #fbf7f0;
        --soft: #a5a3b8;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }

      body {
        min-block-size: 100dvh;
        display: grid;
        place-items: center;
        padding: clamp(1.25rem, 5vw, 3rem);
        padding-block-start: max(clamp(1.25rem, 5vw, 3rem), env(safe-area-inset-top));
        color: var(--ink);
        font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        background:
          radial-gradient(115% 72% at 16% 0%, #2b1d63 0%, transparent 62%),
          radial-gradient(95% 80% at 88% 100%, rgba(68, 74, 165, 0.75) 0%, transparent 58%),
          linear-gradient(165deg, var(--deep) 0%, var(--navy) 68%);
        background-attachment: fixed;
      }

      /* Forge's card, to its own numbers. */
      .card {
        inline-size: 100%;
        max-inline-size: 23rem;
        padding: clamp(1.75rem, 6vw, 2.5rem);
        border: 1px solid var(--edge);
        border-radius: 0.75rem;
        background: var(--panel);
        box-shadow: 0 26px 64px -24px rgba(0, 0, 0, 0.75);
        text-align: center;
      }

      .mark { inline-size: 2.75rem; block-size: 2.75rem; margin: 0 auto 1.5rem; display: block; }

      h1 {
        font-family: 'New York', Georgia, serif;
        font-size: clamp(1.55rem, 5vw, 1.85rem);
        font-weight: 400;
        line-height: 1.15;
        margin: 0 0 0.5rem;
      }
      .lede {
        margin: 0 0 1.75rem;
        color: var(--soft);
        font-size: 0.95rem;
        line-height: 1.55;
      }

      /* What went wrong, if anything ------------------------------------- */
      .note {
        display: grid;
        gap: 0.25rem;
        padding: 0.85rem 1rem;
        margin-block-end: 1.5rem;
        border-radius: 0.75rem;
        text-align: start;
        background: rgba(177, 166, 246, 0.09);
        border: 1px solid rgba(177, 166, 246, 0.28);
      }
      .note--warn {
        background: rgba(255, 173, 128, 0.09);
        border-color: rgba(255, 173, 128, 0.32);
      }
      .note strong { font-size: 0.9rem; font-weight: 700; }
      .note span { font-size: 0.85rem; line-height: 1.5; color: var(--soft); }

      /* The one action. Forge's CTA: outlined periwinkle, filling on hover. */
      .go {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        inline-size: 100%;
        min-block-size: 3rem;
        padding: 0.6rem 1.1rem;
        border: 1px solid var(--peri);
        border-radius: 1rem;
        background: transparent;
        color: var(--peri);
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s ease;
      }
      .go:hover,
      .go:focus-visible {
        background: var(--peri);
        color: #000;
      }
      .go svg { inline-size: 1.1rem; block-size: 1.1rem; flex: 0 0 auto; }
      /* The mark is full-colour, so it needs a light disc once the pill fills. */
      .go__g { border-radius: 50%; }

      :focus-visible { outline: 2px solid var(--peri); outline-offset: 3px; }

      .fine {
        margin: 1.25rem 0 0;
        font-size: 0.8rem;
        line-height: 1.6;
        color: var(--soft);
      }
      .fine code {
        font-family: ui-monospace, Menlo, monospace;
        font-size: 0.95em;
        color: var(--ink);
        white-space: nowrap;
      }
      .alt { margin: 1.5rem 0 0; font-size: 0.8rem; }
      .alt a { color: var(--soft); text-decoration: none; }
      .alt a:hover { color: var(--peri); }

      @media (prefers-reduced-motion: reduce) {
        .go { transition: none; }
      }
    </style>
  </head>

  <body>
    <main class="card">
      <img class="mark" src="/favicon.png" alt="Mesa" width="96" height="96" />

      <h1>BYOB Starter Kit</h1>
      <p class="lede">Eight weeks, eight milestones. Sign in to open it.</p>

      {
        note && (
          <div class:list={['note', note.warn && 'note--warn']} role="alert">
            <strong>{note.title}</strong>
            <span>{note.body}</span>
          </div>
        )
      }

      <a class="go" href={href}>
        <svg class="go__g" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
          <path fill="#4285F4" d="M17.6 9.2c0-.6-.1-1.3-.2-1.8H9v3.5h4.8a4.1 4.1 0 0 1-1.8 2.7v2.2h2.9c1.7-1.6 2.7-3.9 2.7-6.6z"/>
          <path fill="#34A853" d="M9 18c2.4 0 4.5-.8 6-2.2l-2.9-2.2c-.8.5-1.8.9-3.1.9-2.4 0-4.4-1.6-5.1-3.8H.9v2.3A9 9 0 0 0 9 18z"/>
          <path fill="#FBBC05" d="M3.9 10.7a5.4 5.4 0 0 1 0-3.4V5H.9a9 9 0 0 0 0 8l3-2.3z"/>
          <path fill="#EA4335" d="M9 3.6c1.3 0 2.5.5 3.4 1.3l2.6-2.6A9 9 0 0 0 .9 5l3 2.3C4.6 5.2 6.6 3.6 9 3.6z"/>
        </svg>
        {note?.retry ? 'Try a different account' : 'Continue with Google'}
      </a>

      <p class="fine">
        Only {domains.map((d, i) => (<>{i > 0 && ' and '}<code>@{d}</code></>))} accounts can open the kit.
      </p>

      <p class="alt"><a href="https://mesaschool.co/" rel="noopener">Back to mesaschool.co</a></p>
    </main>
  </body>
</html>
