---
/**
 * Sign in.
 *
 * Self-contained on purpose: it is the one page that has to render when
 * something else has gone wrong, so it borrows no stylesheet and no component
 * from the kit. It also has to render for someone who has no session, which is
 * why middleware lets it through.
 *
 * The email field does not authenticate anything — Google does that. It carries
 * a `login_hint` so the account chooser opens on the right address, which saves
 * a student two taps. The button works with the field empty.
 */
export const prerender = false;

import { env } from '../lib/auth';

const domains = (env('ALLOWED_EMAIL_DOMAINS') || 'mesaschool.co')
  .split(',')
  .map((d) => d.trim())
  .filter(Boolean);

const reason = Astro.url.searchParams.get('reason') ?? '';
const next = Astro.url.searchParams.get('next') ?? '/';
const safeNext = next.startsWith('/') && !next.startsWith('//') ? next : '/';

/** What happened, and what to do about it. Never just "an error occurred". */
const NOTES: Record<string, { tone: 'warn' | 'calm'; title: string; body: string; retry?: boolean }> =
  {
    not_allowed: {
      tone: 'warn',
      title: 'That’s not a Mesa account',
      body: `Sign-in worked, but that address isn’t on ${domains
        .map((d) => '@' + d)
        .join(' or ')}. Pick your Mesa account and try again.`,
      retry: true,
    },
    unverified: {
      tone: 'warn',
      title: 'That address isn’t verified',
      body: 'Google hasn’t verified the email on that account. Verify it with Google, then come back.',
      retry: true,
    },
    access_denied: {
      tone: 'calm',
      title: 'Sign-in cancelled',
      body: 'Nothing happened. You can try again whenever you’re ready.',
    },
    state_mismatch: {
      tone: 'calm',
      title: 'That link had expired',
      body: 'Sign-in links are short-lived. Starting again takes a second.',
    },
    bad_request: {
      tone: 'calm',
      title: 'That sign-in was incomplete',
      body: 'Something was missing on the way back from Google. Try once more.',
    },
    token_exchange: {
      tone: 'warn',
      title: 'Google couldn’t finish',
      body: 'The sign-in didn’t complete on Google’s side. Wait a moment and try again.',
    },
    no_id_token: {
      tone: 'warn',
      title: 'Google didn’t return an identity',
      body: 'That usually clears on a second attempt.',
    },
    wrong_audience: {
      tone: 'warn',
      title: 'That sign-in was for a different app',
      body: 'Start again from this page rather than an old link or bookmark.',
    },
    signed_out: {
      tone: 'calm',
      title: 'You’re signed out',
      body: 'Sign in again whenever you need the kit.',
    },
  };

const note = NOTES[reason];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in — BYOB Starter Kit</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0d0e21" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="180x180" />
    <link rel="preload" href="/fonts/manrope-variable.woff2" as="font" type="font/woff2" crossorigin />

    <style is:inline>
      @font-face {
        font-family: 'Manrope';
        src: url('/fonts/manrope-variable.woff2') format('woff2-variations');
        font-weight: 200 800;
        font-display: swap;
      }
      @font-face {
        font-family: 'New York';
        src: url('/fonts/newyork-regular.woff2') format('woff2');
        font-weight: 400 700;
        font-display: swap;
      }

      :root {
        color-scheme: dark;
        --navy: #0d0e21;
        --panel: #161738;
        --peri: #b1a6f6;
        --indigo: #444aa5;
        --ink: #fbf7f0;
        --soft: #a8a6b8;
        --line: rgba(251, 247, 240, 0.14);
        --r-card: 0.75rem;
        --r-btn: 1rem;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        min-block-size: 100dvh;
        display: grid;
        place-items: center;
        padding: clamp(1rem, 5vw, 3rem);
        padding-block-start: max(clamp(1rem, 5vw, 3rem), env(safe-area-inset-top));
        color: var(--ink);
        font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;

        /* Forge's own purples: deep indigo lit from the top left, its lighter
           indigo from the bottom right, settling into the navy the rest of the
           kit sits on. Fixed, so the gradient doesn't slide under a short card
           on a phone. */
        background:
          radial-gradient(115% 72% at 16% 0%, #2b1d63 0%, transparent 62%),
          radial-gradient(95% 80% at 88% 100%, rgba(68, 74, 165, 0.78) 0%, transparent 58%),
          linear-gradient(165deg, #1e0f51 0%, #0d0e21 68%);
        background-attachment: fixed;
      }

      /* One column at every width — there is no second panel to lose, so the
         layout never has to rearrange itself. */
      .card {
        inline-size: 100%;
        max-inline-size: 24rem;
        padding: clamp(1.6rem, 5.5vw, 2.5rem);
        border-radius: var(--r-card);
        background: rgba(22, 23, 56, 0.66);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow:
          inset 0 0 0 1px var(--line),
          0 26px 64px -24px rgba(0, 0, 0, 0.7);
      }

      .mark { inline-size: 2.5rem; block-size: 2.5rem; display: block; margin-block-end: 1.75rem; }
      h1 {
        font-family: 'New York', Georgia, serif;
        font-size: clamp(1.6rem, 4.5vw, 2rem);
        font-weight: 400;
        line-height: 1.15;
        margin: 0 0 0.5rem;
      }
      .lede { margin: 0 0 1.75rem; color: var(--soft); font-size: 0.95rem; line-height: 1.55; }

      /* status ------------------------------------------------------------ */
      .note {
        display: grid;
        gap: 0.3rem;
        padding: 0.9rem 1rem;
        margin-block-end: 1.5rem;
        border-radius: var(--r-card);
        background: rgba(177, 166, 246, 0.1);
        box-shadow: inset 0 0 0 1px rgba(177, 166, 246, 0.3);
      }
      .note--warn {
        background: rgba(255, 176, 132, 0.1);
        box-shadow: inset 0 0 0 1px rgba(255, 176, 132, 0.35);
      }
      .note strong { font-size: 0.92rem; }
      .note span { font-size: 0.86rem; line-height: 1.5; color: var(--soft); }

      /* the address ------------------------------------------------------- */
      label { display: block; font-size: 0.8rem; font-weight: 700; margin-block-end: 0.45rem; }
      .field {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: stretch;
        border-radius: var(--r-card);
        background: var(--panel);
        box-shadow: inset 0 0 0 1px var(--line);
        transition: box-shadow 0.15s ease;
      }
      .field:focus-within { box-shadow: inset 0 0 0 1.5px var(--peri); }
      .field input,
      .field select {
        min-block-size: 3rem;
        border: 0;
        background: none;
        color: var(--ink);
        font: inherit;
        font-size: 0.95rem;
      }
      .field input { padding-inline: 0.9rem; min-inline-size: 0; }
      .field input:focus, .field select:focus { outline: none; }
      .field input::placeholder { color: #6f6d81; }
      .field select {
        padding-inline: 0.6rem 0.5rem;
        color: var(--soft);
        cursor: pointer;
        border-inline-start: 1px solid var(--line);
        max-inline-size: 12rem;
      }

      button {
        inline-size: 100%;
        min-block-size: 3rem;
        margin-block-start: 1rem;
        border: 0;
        border-radius: var(--r-btn);
        background: var(--peri);
        color: var(--navy);
        font: inherit;
        font-size: 0.95rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        cursor: pointer;
        transition: filter 0.15s ease;
      }
      button:hover { filter: brightness(1.08); }
      button svg { inline-size: 1.05rem; block-size: 1.05rem; }
      :focus-visible { outline: 2px solid var(--peri); outline-offset: 3px; }

      .fine { margin: 1.25rem 0 0; font-size: 0.8rem; line-height: 1.55; color: var(--soft); }
      .fine code {
        font-family: ui-monospace, Menlo, monospace;
        font-size: 0.95em;
        color: var(--ink);
      }
      .alt { margin: 0.9rem 0 0; font-size: 0.8rem; }
      .alt a { color: var(--peri); }

      @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>
  </head>

  <body>
    <main class="card">
      <img class="mark" src="/favicon.png" alt="Mesa" width="96" height="96" />

      <h1>The BYOB Starter Kit</h1>
      <p class="lede">Sign in with your Mesa account to open it.</p>

      {
        note && (
          <div class:list={['note', note.tone === 'warn' && 'note--warn']} role="alert">
            <strong>{note.title}</strong>
            <span>{note.body}</span>
          </div>
        )
      }

      <form action="/api/auth/login" method="get">
        <input type="hidden" name="next" value={safeNext} />
        {note?.retry && <input type="hidden" name="prompt" value="select_account" />}

        <label for="user">Your Mesa address</label>
        <div class="field">
          <input
            id="user"
            name="user"
            type="text"
            inputmode="email"
            autocomplete="username"
            spellcheck="false"
            autocapitalize="none"
            placeholder="firstname"
          />
          <label class="sr-only" for="domain" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)">
            Domain
          </label>
          <select id="domain" name="domain">
            {domains.map((d) => <option value={d}>@{d}</option>)}
          </select>
        </div>

        <button type="submit">
          <svg viewBox="0 0 18 18" aria-hidden="true" focusable="false">
            <path fill="#4285F4" d="M17.6 9.2c0-.6-.1-1.3-.2-1.8H9v3.5h4.8a4.1 4.1 0 0 1-1.8 2.7v2.2h2.9c1.7-1.6 2.7-3.9 2.7-6.6z"/>
            <path fill="#34A853" d="M9 18c2.4 0 4.5-.8 6-2.2l-2.9-2.2c-.8.5-1.8.9-3.1.9-2.4 0-4.4-1.6-5.1-3.8H.9v2.3A9 9 0 0 0 9 18z"/>
            <path fill="#FBBC05" d="M3.9 10.7a5.4 5.4 0 0 1 0-3.4V5H.9a9 9 0 0 0 0 8l3-2.3z"/>
            <path fill="#EA4335" d="M9 3.6c1.3 0 2.5.5 3.4 1.3l2.6-2.6A9 9 0 0 0 .9 5l3 2.3C4.6 5.2 6.6 3.6 9 3.6z"/>
          </svg>
          Continue with Google
        </button>
      </form>

      <p class="fine">
        You’ll sign in with Google. Only {domains.map((d, i) => (
          <>{i > 0 && ' and '}<code>@{d}</code></>
        ))} accounts can open the kit — the address above just saves you a step.
      </p>

      <p class="alt"><a href="https://mesaschool.co/" rel="noopener">Back to mesaschool.co</a></p>
    </main>
  </body>
</html>
