---
/** The Channel Playbook: what's in it, and where to go. */
import Kit from '../../layouts/Kit.astro';
import { getChannels, getMoney } from '../../lib/content';

export const prerender = false;
const channels = await getChannels();
const money = await getMoney();
---

<Kit title="Playbook" description={money.playbookLede} current="/playbook">
  <header class="ph">
    <p class="kicker">The BYOB Channel Playbook</p>
    <h1 class="disp disp--lg">Five ways to sell.</h1>
    <p class="lede">{money.playbookLede}</p>
  </header>

  <p class="intro">{money.playbookIntro}</p>

  <section class="sec" aria-labelledby="mm">
    <h2 class="disp disp--sm" id="mm">Money matters</h2>
    <div class="grid2">
      <a class="card card--link" href="/playbook/inventory">
        <h3 class="card__t">Inventory</h3>
        <p class="card__b">{money.inventory.oneLine}</p>
      </a>
      <a class="card card--link" href="/playbook/revenue">
        <h3 class="card__t">Revenue &amp; Expenses</h3>
        <p class="card__b">{money.revenue.oneLine}</p>
      </a>
    </div>
  </section>

  <section class="sec" aria-labelledby="ch">
    <h2 class="disp disp--sm" id="ch">The five channels</h2>
    <div class="grid2">
      {channels.map((c) => (
        <a class="card card--link" href={`/playbook/${c.id}`}>
          <span class="num-mark mono">{c.code}</span>
          <h3 class="card__t">{c.name}</h3>
          <p class="card__b">{c.oneLine}</p>
        </a>
      ))}
    </div>
  </section>

  <p class="aside">{money.videoNote}</p>
</Kit>

<style>
  .ph { display: grid; gap: var(--sp-3); padding-block-end: var(--sp-5); }
  .intro { font-size: var(--s-0); line-height: 1.75; color: var(--text-soft); max-inline-size: 66ch; padding-block-end: var(--sp-5); }
  .sec { padding-block: var(--sp-5); display: grid; gap: var(--sp-4); }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr)); gap: var(--sp-4); }
  .card {
    display: grid; gap: var(--sp-2); align-content: start;
    padding: var(--sp-5);
    border-radius: var(--r-card);
    background: var(--card);
    box-shadow: inset 0 0 0 1.4px var(--card-line);
  }
  .card--link { text-decoration: none; transition: box-shadow var(--fast) var(--ease); }
  .card--link:hover { box-shadow: inset 0 0 0 1.4px var(--coral); }
  .card__t { font-family: var(--font-display); font-size: var(--s-1); color: var(--ink-2); }
  .card__b { font-size: var(--s--1); line-height: 1.65; color: var(--text-soft); }
</style>
