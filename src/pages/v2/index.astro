<script>
  /**
   * Light stemming so a student typing "replies" finds "aren't replying", and
   * "creator" finds "creators". Cheap suffix variants, not a real stemmer.
   */
  function variants(term: string) {
    const v = new Set([term]);
    if (term.endsWith('ies')) v.add(term.slice(0, -3) + 'y');
    if (term.endsWith('es')) v.add(term.slice(0, -2));
    if (term.endsWith('s')) v.add(term.slice(0, -1));
    if (term.length > 4) v.add(term.replace(/(ing|ed)$/, ''));
    return [...v].filter((x) => x.length > 2);
  }

  function matches(haystack: string, term: string) {
    return variants(term).some((v) => haystack.includes(v));
  }

  /* ---------------------------------------------------------- diagnostic */
  function filterList(opts: {
    input: string;
    chips: string;
    items: string;
    count: string;
    empty: string;
    attr: 'channel' | 'tags';
    noun: string;
  }) {
    const input = document.querySelector<HTMLInputElement>(opts.input);
    const chips = [...document.querySelectorAll<HTMLButtonElement>(opts.chips)];
    const items = [...document.querySelectorAll<HTMLElement>(opts.items)];
    const count = document.querySelector<HTMLElement>(opts.count);
    const empty = document.querySelector<HTMLElement>(opts.empty);
    if (!input || !count || !empty || !items.length) return;

    let filter = 'all';

    const apply = () => {
      const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;

      for (const item of items) {
        const hay = item.dataset.text ?? '';
        const field = item.dataset[opts.attr] ?? '';
        const matchesFilter =
          filter === 'all' ||
          (opts.attr === 'tags' ? field.includes(filter) : field === filter);
        const visible = matchesFilter && terms.every((t) => matches(hay, t));

        item.hidden = !visible;
        if (visible) {
          shown++;
          /* Filtering can pull in an item that was never scroll-revealed. */
          item.classList.add('is-revealed');
        } else {
          item.querySelector('details')?.removeAttribute('open');
          if (item instanceof HTMLDetailsElement) item.open = false;
        }
      }

      empty.hidden = shown > 0;
      count.textContent =
        shown === items.length
          ? `${items.length} ${opts.noun}`
          : `${shown} of ${items.length} ${opts.noun}`;
    };

    input.addEventListener('input', apply);
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        filter = chip.dataset.filter ?? chip.dataset.tag ?? 'all';
        chips.forEach((c) => {
          const on = c === chip;
          c.classList.toggle('is-on', on);
          c.setAttribute('aria-pressed', String(on));
        });
        apply();
      })
    );
  }

  filterList({
    input: '#dx-search',
    chips: '.dx__filters .dx__chip',
    items: '.dx__item',
    count: '.dx__count',
    empty: '.dx__empty',
    attr: 'channel',
    noun: 'symptoms',
  });

  filterList({
    input: '#fq-search',
    chips: '.fq__tags .dx__chip',
    items: '.fq__i',
    count: '.fq__count',
    empty: '.fq__empty',
    attr: 'tags',
    noun: 'questions',
  });

  /* A deep link like #faq-repay opens that question. */
  const target = location.hash ? document.querySelector(location.hash) : null;
  if (target instanceof HTMLDetailsElement) target.open = true;
</script>
