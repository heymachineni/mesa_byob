---
import Base from '../../layouts/Base.astro';
import Chapter from '../../components/Chapter.astro';
import Drawer from '../../components/Drawer.astro';
import MilestonePanel from '../../components/MilestonePanel.astro';
import ChannelPanel from '../../components/ChannelPanel.astro';
import WorkshopPanel from '../../components/WorkshopPanel.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import Confirming from '../../components/Confirming.astro';
import RevenueLadder from '../../components/RevenueLadder.astro';
import Icon from '../../components/Icon.astro';
import Comma from '../../components/Comma.astro';
import {
  getProgram,
  getPhases,
  getMilestones,
  getWorkshops,
  getChannels,
  getChannelTargets,
  getTargetBreakdown,
  getRevenueLadder,
  getMoney,
  getFlea,
  getFaqs,
  getFaqTags,
  getWip,
  getAllSymptoms,
  getStillStuck,
} from '../../lib/content';
import { rupeesCompact, rupees } from '../../lib/format';

const program = await getProgram();
const phases = await getPhases();
const milestones = await getMilestones();
const workshops = await getWorkshops();
const channels = await getChannels();
const targets = await getChannelTargets();
const breakdown = await getTargetBreakdown();
const ladder = await getRevenueLadder();
const money = await getMoney();
const flea = await getFlea();
const faqs = await getFaqs();
const faqTags = await getFaqTags();
const wip = await getWip();
const symptoms = await getAllSymptoms();
const stillStuck = await getStillStuck();

const { inventory, revenue } = money;
const m8 = milestones.find((m) => m.id === 'm8')!;
const ws13 = workshops.find((w) => w.id === 'ws13');
const fleaTarget = targets.find((t) => t.id === 'flea-market');
const gated = milestones.filter((m) => m.gate);
const sumsToTarget = breakdown.total === program.revenueTarget;

/* A glyph per channel, naming the thing rather than decorating it. */
const CHANNEL_ICON = {
  offline: 'stall',
  'online-organic': 'phone',
  influencer: 'megaphone',
  performance: 'target',
  b2b: 'handshake',
} as const;

const fractionOf = (v: number) =>
  program.revenueTarget > 0 ? v / program.revenueTarget : 0;

const stats = [
  { v: String(program.weeks), u: 'weeks', s: `${program.startLabel} → ${program.endLabel}` },
  { v: String(program.milestoneCount), u: 'milestones', s: 'Every one mandatory and dated' },
  { v: '₹7L', u: 'minimum revenue', s: 'From real customers, not projections' },
  { v: program.teamSizeLabel, u: '', s: 'Your team for the whole sprint' },
];
---

<Base title={program.title} description={program.heroSupport} suffix={false}>
  <!-- ═══════════════════════════════════════════════════════════ OPENING -->
  <section class="hero band" data-tone="dark">
    <div class="hero__comma" aria-hidden="true"><Comma tone="orchid" opacity={0.08} /></div>
    <div class="u-container hero__inner">
      <p class="hero__kicker label">{program.heroKicker}</p>
      <h1 class="display display--xl hero__title">{program.heroStatement}</h1>
      <p class="hero__lede">{program.heroSupport}</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#journey">
          Start the journey <span class="arrow">↓</span>
        </a>
        <button class="btn btn--ghost" type="button" data-cmd-open>
          Search the kit <kbd class="hero__kbd">⌘K</kbd>
        </button>
      </div>

      <ul class="hero__stats" data-reveal-group>
        {
          stats.map((s) => (
            <li data-reveal>
              <span class="hero__stat-v display">{s.v}</span>
              {s.u && <span class="hero__stat-u">{s.u}</span>}
              <span class="hero__stat-s">{s.s}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════ WHAT THIS IS -->
  <section class="section band" id="what">
    <div class="u-container">
      <Chapter
        n="01"
        label="What you're getting into"
        title="Six things that define BYOB"
        lede="Identify a customer need, build a D2C product, and sell it to real people. Everything else follows from that."
      />

      <ol class="defs" data-reveal-group>
        {
          program.structure.map((item) => (
            <li class="def" data-reveal>
              <span class="def__n mono">{item.n}</span>
              <h3 class="def__t">{item.title}</h3>
              <p class="def__b">{item.body}</p>
            </li>
          ))
        }
      </ol>

      <div class="notes">
        <p class="callout"><strong>Key outcome.</strong> {program.keyOutcome}</p>
        <p class="callout callout--cta">
          <strong>How capital works.</strong> {program.capitalNote}
        </p>
      </div>

      <details class="acc gains" data-reveal>
        <summary>Why this is worth eight hard weeks — 6 things you'll gain</summary>
        <div class="acc__body">
          <p class="gains__intro">{program.gainsIntro}</p>
          <ol class="gains__list">
            {
              program.gains.map((g, i) => (
                <li>
                  <span class="gains__n mono">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <h4 class="gains__t">{g.title}</h4>
                    <p class="gains__b">{g.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <p class="gains__close hand">{program.closingNote}</p>
          <div class="gains__video">
            {program.watch.map((v) => <VideoEmbed video={v} />)}
          </div>
        </div>
      </details>
    </div>
  </section>

  <!-- ═════════════════════════════════════════════════════════ THE CLIMB -->
  <section class="section band" data-tone="dark">
    <div class="u-container">
      <Chapter
        n="02"
        label="The number"
        title="Zero to ₹7 lakhs, in eight steps"
        lede="₹7 lakhs sounds like a lot until you see it broken into checkpoints. Each rung is a bar your venture clears before the next one unlocks."
      />
      <RevenueLadder rungs={ladder} />
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════ JOURNEY -->
  <section class="section band" id="journey">
    <div class="u-container">
      <Chapter
        n="03"
        label="Weeks 1–8"
        title="The journey"
        lede="Four phases, eight milestones. Each is mandatory and dated — you can hit them early, but missing a deadline affects your grade, your next capital tranche, and gets escalated to your mentor and the Investment Committee."
      />

      <div class="jrn" data-reveal-group>
        {
          phases.map((phase) => {
            const ms = milestones.filter((m) => m.phase === phase.id);
            return (
              <section class="jrn__phase" data-reveal>
                <header class="jrn__ph-head">
                  <div class="jrn__ph-top">
                    <span class="jrn__ph-n mono">{phase.code}</span>
                    <h3 class="jrn__ph-name display display--sm">{phase.name}</h3>
                  </div>
                  <p class="jrn__ph-weeks label">{phase.weeks}</p>
                  <p class="jrn__ph-sum">{phase.summary}</p>
                  <ul class="jrn__beats">
                    {phase.beats.map((b) => (
                      <li class="hand">{b}</li>
                    ))}
                  </ul>
                </header>

                <div class="jrn__cards">
                  {ms.map((m) => (
                    <button class="ms" type="button" data-open={m.id}>
                      {m.gate && <span class="tape tape--right" aria-hidden="true" />}
                      {m.id === 'm1' && <span class="annot">Start here</span>}
                      {m.id === 'm8' && <span class="annot annot--violet">Final day</span>}
                      <span class="ms__top">
                        <span class="ms__code mono">{m.code}</span>
                        <span class="ms__wk">Week {m.week}</span>
                      </span>
                      <span class="ms__head display display--xs">{m.headline}</span>
                      <span class="ms__rev num">{m.revenueLabel}</span>
                      <span class="ms__foot">
                        <span class="ms__date">{m.date}</span>
                        {m.gate && <span class="ms__gate">{m.gate.name}</span>}
                      </span>
                      <span class="ms__cta">
                        Explore {m.code} <span class="arrow" aria-hidden="true">→</span>
                      </span>
                    </button>
                  ))}
                </div>
              </section>
            );
          })
        }
      </div>

      <!-- Investment gates, kept on the page rather than buried in a drawer. -->
      <div class="gates" id="gate-map" data-reveal>
        <Chapter n="03·b" label="Investment" title="How the gates work" size="sm" />
        <p class="gates__lede">
          Mesa's capital is interest-free debt, released in tranches. The Investment
          Committee reviews that milestone's deliverables against its targets — hit the bar
          and the next tranche unlocks.
        </p>
        <div class="gates__grid">
          {
            gated.map((m) => (
              <article class="gate">
                <div class="gate__top">
                  <span class="pill pill--gate">{m.gate!.name}</span>
                  <button class="gate__at mono" type="button" data-open={m.id}>
                    {m.code} <span class="arrow" aria-hidden="true">→</span>
                  </button>
                </div>
                <p class="gate__rule">
                  {m.gateConfirming ? (
                    <Confirming note={m.gateConfirming.note}>{m.gate!.rule}</Confirming>
                  ) : (
                    m.gate!.rule
                  )}
                </p>
                {m.gate!.spendOn.length > 0 && (
                  <ul class="gate__spend">
                    {m.gate!.spendOn.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                )}
              </article>
            ))
          }
        </div>
        <p class="callout callout--cta gates__cap">
          <strong>The cap.</strong> You can raise interest-free debt of up to{' '}
          <Confirming note={program.capitalConfirming!.note}>
            {program.capitalMaxLabel}
          </Confirming>{' '}
          from Mesa, in tranches of {program.trancheLabel}. All of it must be repaid by{' '}
          {program.repaymentLabel}.
        </p>
        <p class="confirming-note">
          * The total capital amount has not been finalised by the program team yet. Confirm
          with your mentor before planning around it.
        </p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════ WORKSHOPS -->
  <section class="section band" id="workshops" data-tone="dark">
    <div class="u-container">
      <Chapter
        n="04"
        label="Support"
        title="13 things you'll learn before you sell"
        lede="Mesa runs workshops with functional experts and startup leaders throughout the challenge, timed to what each milestone needs."
      />

      <ol class="ws" data-reveal-group>
        {
          workshops.map((w) => {
            const ms = milestones.find((m) => m.id === w.milestone);
            return (
              <li data-reveal>
                <button class="ws__row" type="button" data-open={w.id}>
                  <span class="ws__code mono">{w.code}</span>
                  <span class="ws__title">{w.title}</span>
                  <span class="ws__for">{ms ? `for ${ms.code}` : ''}</span>
                  <span class="arrow ws__go" aria-hidden="true">→</span>
                </button>
              </li>
            );
          })
        }
      </ol>

      <p class="ws__note">
        Pairings show when each session is most useful — check the program schedule for
        confirmed dates. You also get a mentor check-in every week; each milestone carries
        the question yours will open with.
      </p>
    </div>
  </section>

  <!-- ═════════════════════════════════════════════════════════ CHANNELS -->
  <section class="section band" id="channels">
    <div class="u-container">
      <Chapter
        n="05"
        label="Your D2C sales guide"
        title="Five ways to sell"
        lede="Every team's path to ₹7L runs through some mix of all five. Open one for the full playbook — the how, when, where, what to do when it stops working, and what good looks like."
      />

      <ol class="chn" data-reveal-group>
        {
          channels.map((c) => {
            const t = targets.find((x) => x.id === c.target);
            return (
              <li data-reveal>
                <button class="chn__card" type="button" data-open={c.id}>
                  <span class="chn__top">
                    <span class="chn__code mono">{c.code}</span>
                    <Icon name={CHANNEL_ICON[c.id as keyof typeof CHANNEL_ICON]} size={30} />
                  </span>
                  <span class="chn__name display display--xs">{c.name}</span>
                  <span class="chn__line">{c.oneLine}</span>
                  <span class="chn__meta">
                    {t?.winRevenue !== null && t?.winRevenue !== undefined && (
                      <span class="chn__target num">{rupeesCompact(t.winRevenue)} target</span>
                    )}
                    <span class="chn__open">
                      Open playbook <span class="arrow" aria-hidden="true">→</span>
                    </span>
                  </span>
                </button>
              </li>
            );
          })
        }
      </ol>

      <!-- The ₹7L breakdown: computed, not asserted. -->
      <div class="tgt" id="targets" data-reveal>
        <Chapter
          n="05·b"
          label="Channel targets"
          title={sumsToTarget ? 'This is how ₹7 lakhs adds up' : 'Targets by channel'}
          size="sm"
        />
        <p class="tgt__lede">
          {
            sumsToTarget
              ? `Each channel carries its own win target — and together they come to exactly ${program.revenueTargetLabel}. That's where the number comes from.`
              : 'The win target set for each channel.'
          }
        </p>

        <div class="tgt__bar" role="img" aria-label={`Channel targets summing to ${rupees(breakdown.total)}`}>
          {
            breakdown.rows.map((row, i) => (
              <span class="tgt__seg" style={`--share:${(row.share * 100).toFixed(2)}%;--i:${i}`} />
            ))
          }
        </div>

        <ul class="tgt__key">
          {
            breakdown.rows.map((row, i) => (
              <li>
                <span class="tgt__dot" style={`--i:${i}`} aria-hidden="true" />
                <span class="tgt__n">{row.name}</span>
                <span class="tgt__v num">{rupeesCompact(row.winRevenue)}</span>
              </li>
            ))
          }
          <li class="tgt__total">
            <span class="tgt__dot tgt__dot--none" aria-hidden="true"></span>
            <span class="tgt__n">Total</span>
            <span class="tgt__v num">{rupeesCompact(breakdown.total)}</span>
          </li>
        </ul>

        <details class="acc">
          <summary>The full target table — minimums, wins and budgets</summary>
          <div class="acc__body table-scroll">
            <table>
              <caption class="sr-only">Minimum and win targets per channel</caption>
              <thead>
                <tr>
                  <th scope="col">Channel</th>
                  <th scope="col">Minimum</th>
                  <th scope="col">Win</th>
                  <th scope="col">Budget</th>
                </tr>
              </thead>
              <tbody>
                {
                  [...breakdown.rows, ...breakdown.nonRevenue].map((t) => (
                    <tr>
                      <th scope="row">
                        {t.channel ? (
                          <button class="tgt__link" type="button" data-open={t.channel}>
                            {t.name}
                          </button>
                        ) : (
                          t.name
                        )}
                        {t.tof && <span class="tgt__tof">Top of funnel: {t.tof}</span>}
                      </th>
                      <td>
                        {t.min.length ? (
                          <ul class="dotlist">
                            {t.min.map((x) => (
                              <li>{x}</li>
                            ))}
                          </ul>
                        ) : (
                          '—'
                        )}
                      </td>
                      <td>
                        <ul class="dotlist">
                          {t.win.map((x) => (
                            <li>{x}</li>
                          ))}
                        </ul>
                        {t.note && <span class="tgt__tof">{t.note}</span>}
                      </td>
                      <td class="num">{t.budget ?? '—'}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="confirming-note">
              Budget figures appear in the Starter Pack without a stated unit or period, and
              are reproduced exactly as written. Check with your mentor before planning spend.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ MONEY -->
  <section class="section band" id="money" data-tone="dark">
    <div class="u-container">
      <Chapter
        n="06"
        label="Cuts across every channel"
        title="Money matters"
        lede="Two things decide whether your revenue number means anything: how you manage stock, and whether you know what each sale actually costs you."
      />

      <div class="mm">
        <!-- ---------------------------------------------------- inventory -->
        <article class="mm__half">
          <span class="mm__ico"><Icon name="box" size={34} /></span>
          <h3 class="mm__t display display--sm">Inventory</h3>
          <p class="mm__hook hand">Don't let your cash sit on a shelf.</p>
          <p class="mm__intro">{inventory.intro}</p>

          <dl class="terms">
            {
              inventory.terms.map((t) => (
                <div class="term">
                  <dt>{t.term}</dt>
                  <dd>{t.body}</dd>
                </div>
              ))
            }
          </dl>

          <details class="acc">
            <summary>How to think about it, phase by phase</summary>
            <div class="acc__body">
              <ol class="mm__phases">
                {
                  inventory.phases.map((p) => (
                    <li>
                      <h4 class="mm__ph-l">{p.label}</h4>
                      <p>{p.body}</p>
                    </li>
                  ))
                }
              </ol>
              <p class="callout mm__sys"><strong>A simple system.</strong> {inventory.system}</p>
            </div>
          </details>

          <details class="acc">
            <summary>Avoid this</summary>
            <div class="acc__body">
              <ul class="avoid">
                {inventory.avoid.map((a) => <li>{a}</li>)}
              </ul>
            </div>
          </details>

          <details class="acc">
            <summary>Watch & learn · {inventory.videos.length}</summary>
            <div class="acc__body">
              <div class="mm__vids">
                {inventory.videos.map((v) => <VideoEmbed video={v} />)}
              </div>
            </div>
          </details>
        </article>

        <!-- ----------------------------------------------- revenue/expense -->
        <article class="mm__half">
          <span class="mm__ico"><Icon name="receipt" size={34} /></span>
          <h3 class="mm__t display display--sm">Revenue & expenses</h3>
          <p class="mm__hook hand">₹7L in sales doesn't mean ₹7L in your pocket.</p>
          <p class="mm__intro">{revenue.intro}</p>

          <!-- The margin equation, drawn as the subtraction it actually is. -->
          <div class="eq">
            <p class="label eq__cap">Track these five numbers weekly</p>
            {
              revenue.numbers.map((n, i) => {
                const last = i === revenue.numbers.length - 1;
                return (
                  <div class:list={['eq__row', last && 'eq__row--out']}>
                    <span class="eq__op mono" aria-hidden="true">
                      {i === 0 ? '' : last ? '=' : '−'}
                    </span>
                    <span class="eq__n">{n.name}</span>
                    <span class="eq__d">{n.body}</span>
                  </div>
                );
              })
            }
          </div>

          <details class="acc">
            <summary>The financial lens at each milestone</summary>
            <div class="acc__body">
              <div class="lens">
                {
                  revenue.lens.map((l) => (
                    <div class="lens__i">
                      <div class="lens__top">
                        <h4 class="lens__m">{l.milestone}</h4>
                        <span class="lens__g num">{l.revGoal}</span>
                      </div>
                      <p class="lens__f"><span class="label">Focus</span>{l.focus}</p>
                      <p class="lens__w"><span class="label">Watch for</span>{l.watchFor}</p>
                    </div>
                  ))
                }
              </div>
            </div>
          </details>
        </article>
      </div>

      <!-- The memorable moment. -->
      <blockquote class="qq" data-reveal>
        <p class="qq__q display">{revenue.question}</p>
        <footer class="qq__f">{revenue.questionBody}</footer>
      </blockquote>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ STUCK -->
  <section class="section band" id="stuck">
    <div class="u-container">
      <Chapter
        n="07"
        label="Diagnostic"
        title="Something not working?"
        lede="Every fix from all five playbooks, in one place. Pick what's actually happening — not the channel you think is at fault."
      />

      <div class="dx plane plane--drawn" data-reveal>
        <span class="annot">Stuck? Start here</span>
        <div class="dx__controls">
          <label class="sr-only" for="dx-search">Describe what's happening</label>
          <input
            id="dx-search"
            type="text"
            placeholder="Describe it — “nobody buys”, “no replies”, “low ROAS”…"
            autocomplete="off"
            spellcheck="false"
          />
          <div class="dx__filters" role="group" aria-label="Filter by channel">
            <button type="button" class="dx__chip is-on" data-filter="all" aria-pressed="true">
              All
            </button>
            {
              channels.map((c) => (
                <button type="button" class="dx__chip" data-filter={c.id} aria-pressed="false">
                  {c.name}
                </button>
              ))
            }
          </div>
        </div>

        <p class="dx__count" role="status" aria-live="polite">
          {symptoms.length} symptoms
        </p>

        <ul class="dx__list">
          {
            symptoms.map((s) => (
              <li
                class="dx__item"
                data-channel={s.channelId}
                data-text={`${s.symptom} ${s.fix} ${s.channelName}`.toLowerCase()}
              >
                <!-- `name` makes these a native exclusive accordion: opening one
                     answer closes the last, so two fixes are never on screen. -->
                <details name="diagnostic">
                  <summary>
                    <span class="dx__sym hand">{s.symptom}</span>
                    <span class="dx__ch">{s.channelName}</span>
                    <span class="dx__chev" aria-hidden="true" />
                  </summary>
                  <div class="dx__fix">
                    <p>{s.fix}</p>
                    <button class="dx__more" type="button" data-open={s.channelId}>
                      Full {s.channelName} playbook <span class="arrow" aria-hidden="true">→</span>
                    </button>
                  </div>
                </details>
              </li>
            ))
          }
        </ul>

        <p class="dx__empty" hidden>
          Nothing matches that. Try a shorter phrase, clear the filter, or take it straight
          to your Wednesday 1:1.
        </p>
      </div>

      <aside class="ss" data-reveal>
        <h3 class="ss__t display display--xs">{stillStuck.title}</h3>
        <p class="ss__b">{stillStuck.body}</p>
        <ul class="dotlist ss__bring">
          {stillStuck.bring.map((b) => <li>{b}</li>)}
        </ul>
        <p class="ss__c hand">{stillStuck.closing}</p>
      </aside>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ FLEA -->
  <section class="flea band" id="flea" data-tone="deep">
    <div class="flea__comma" aria-hidden="true"><Comma tone="orchid" opacity={0.1} /></div>
    <div class="u-container">
      <div class="flea__open" data-reveal>
        <p class="label">{flea.kicker}</p>
        <p class="flea__seq">{flea.lede}</p>
        <span class="flea__arrow" aria-hidden="true">↓</span>
        <h2 class="display display--xl flea__name">Mesa Flea</h2>
        <div class="flea__chips">
          <span class="pill">
            {m8.dateConfirming ? (
              <Confirming note={m8.dateConfirming.note}>{m8.date}</Confirming>
            ) : (
              m8.date
            )}
          </span>
          <span class="pill">{m8.deadlineLabel}</span>
          {
            fleaTarget?.winRevenue && (
              <span class="pill pill--accent">
                {rupeesCompact(fleaTarget.winRevenue)} target on the day
              </span>
            )
          }
        </div>
      </div>

      <div class="flea__story prose" data-reveal-group>
        {
          flea.paragraphs.map((p, i) => (
            <p class:list={[i === 0 && 'flea__first']} data-reveal>
              {p}
            </p>
          ))
        }
      </div>

      <div class="flea__grid">
        <section class="flea__why" data-reveal>
          <h3 class="flea__h">{flea.whyBestTitle}</h3>
          <ol class="flea__why-list">
            {
              flea.whyBest.map((w) => (
                <li>
                  <h4>{w.title}</h4>
                  <p>{w.body}</p>
                </li>
              ))
            }
          </ol>
        </section>

        <aside class="proof plane plane--kit" data-reveal>
          <span class="tape tape--left" aria-hidden="true"></span>
          <span class="flag">Proof it works</span>
          <h3 class="proof__n display display--sm">{flea.proof.title}</h3>
          <p class="proof__b">{flea.proof.body}</p>
          <div class="proof__l"><VideoEmbed video={flea.proof.link} /></div>
        </aside>
      </div>

      <div class="flea__prep" data-reveal>
        <h3 class="flea__h">Getting ready</h3>
        <div class="prep">
          <article class="prep__c">
            <h4><span class="mono">{m8.code}</span> deliverables</h4>
            <ul class="checklist">{m8.deliverables.map((d) => <li>{d}</li>)}</ul>
            <button class="prep__b" type="button" data-open="m8">
              Open M8 <span class="arrow" aria-hidden="true">→</span>
            </button>
          </article>

          {
            ws13 && (
              <article class="prep__c">
                <h4><span class="mono">{ws13.code}</span> {ws13.title}</h4>
                <p>{ws13.expect}</p>
                <button class="prep__b" type="button" data-open={ws13.id}>
                  Open workshop <span class="arrow" aria-hidden="true">→</span>
                </button>
              </article>
            )
          }

          <article class="prep__c">
            <span class="prep__ico"><Icon name="box" size={26} /></span>
            <h4>Stock & float</h4>
            <p>
              Order specifically for the Flea — a single-day, high-footfall event. Running
              out by noon means leaving revenue you can't get back. Plan inventory and float
              (change, backup UPI) for one big day.
            </p>
            <a class="prep__b" href="#money">
              Inventory guidance <span class="arrow" aria-hidden="true">→</span>
            </a>
          </article>

          <article class="prep__c">
            <span class="prep__ico"><Icon name="stall" size={26} /></span>
            <h4>Working the stall</h4>
            <p>
              The Offline playbook is the Flea playbook: pick your spot, lead with a hook,
              let people hold the product, close with a bundle, capture every contact.
            </p>
            <button class="prep__b" type="button" data-open="offline">
              Offline playbook <span class="arrow" aria-hidden="true">→</span>
            </button>
          </article>
        </div>
      </div>

      <div class="flea__watch" id="watch" data-reveal>
        <h3 class="flea__h">Watch — get hyped</h3>
        <p class="flea__watch-i">{flea.watchIntro}</p>

        <p class="label flea__wl">From past Flea Days</p>
        <div class="flea__vids">
          {flea.pastReels.map((v) => <VideoEmbed video={v} />)}
        </div>
        <p class="confirming-note flea__pn">{flea.placeholderNote}</p>

        <p class="label flea__wl">Real Mesa content</p>
        <div class="flea__vids">
          {flea.realContent.map((v) => <VideoEmbed video={v} />)}
        </div>
        <p class="confirming-note flea__pn">{stillStuck.videoNote}</p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════ FAQ -->
  <section class="section band" id="faq">
    <div class="u-container u-narrow">
      <Chapter
        n="08"
        label="Before you start"
        title="What students ask"
        lede={`${faqs.length} questions, answered by the program team.`}
      />

      <div class="fq" data-reveal>
        <label class="sr-only" for="fq-search">Search questions</label>
        <input
          id="fq-search"
          type="text"
          placeholder="Search the FAQ…"
          autocomplete="off"
          spellcheck="false"
        />
        <div class="fq__tags" role="group" aria-label="Filter by topic">
          <button type="button" class="dx__chip is-on" data-tag="all" aria-pressed="true">
            All
          </button>
          {
            faqTags.map((t) => (
              <button type="button" class="dx__chip" data-tag={t} aria-pressed="false">
                {t}
              </button>
            ))
          }
        </div>

        <p class="fq__count" role="status" aria-live="polite">{faqs.length} questions</p>

        <div class="fq__list">
          {
            faqs.map((f) => (
              <details
                class="acc fq__i"
                id={`faq-${f.id}`}
                data-tags={f.tags.join(' ').toLowerCase()}
                data-text={`${f.q} ${f.a}`.toLowerCase()}
              >
                <summary>{f.q}</summary>
                <div class="acc__body">
                  <p>{f.a}</p>
                </div>
              </details>
            ))
          }
        </div>

        <p class="fq__empty" hidden>
          No question matches that. Try fewer words — or ask your mentor at the Wednesday 1:1.
        </p>
      </div>

      <div class="wip" data-reveal>
        <p class="label wip__l">Still being written</p>
        <div class="wip__grid">
          {
            wip.map((w) => (
              <article class="wip__c">
                <span class="wip__badge">Coming soon</span>
                <h3>{w.title}</h3>
                <p>{w.body}</p>
                {w.pointer && <p class="wip__p">{w.pointer}</p>}
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════════════════════════════════════════════════════ ALL PANELS -->
  <Drawer>
    {
      milestones.map((m, i) => (
        <MilestonePanel
          milestone={m}
          phase={phases.find((p) => p.id === m.phase)!}
          workshops={m.workshops
            .map((id) => workshops.find((w) => w.id === id))
            .filter((w): w is NonNullable<typeof w> => Boolean(w))}
          channels={m.channels
            .map((id) => channels.find((c) => c.id === id))
            .filter((c): c is NonNullable<typeof c> => Boolean(c))}
          seq={i}
          fraction={fractionOf(m.revenueGoal)}
        />
      ))
    }
    {
      channels.map((c, i) => (
        <ChannelPanel
          channel={c}
          target={targets.find((t) => t.id === c.target) ?? null}
          milestones={milestones.filter((m) => m.channels.includes(c.id))}
          seq={i}
        />
      ))
    }
    {
      workshops.map((w, i) => (
        <WorkshopPanel
          workshop={w}
          phase={phases.find((p) => p.id === w.phase)}
          milestone={milestones.find((m) => m.id === w.milestone)}
          seq={i}
        />
      ))
    }
  </Drawer>
</Base>

