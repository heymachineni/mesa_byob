  }
  .ses__r:hover { background: color-mix(in srgb, var(--coral) 8%, transparent); padding-inline: var(--sp-3); }
  .ses__c { font-size: var(--s--2); font-weight: 700; color: var(--coral); }
  .ses__t { font-family: var(--font-display); font-size: var(--s-1); color: var(--ink-2); text-align: start; }
  .ses__f { font-family: var(--font-mono); font-size: var(--s--2); color: var(--text-faint); }
  .ses__a { color: var(--coral); }
  .ses__n { margin-block-start: var(--sp-5); }
  @media (max-width: 40rem) { .ses__r { grid-template-columns: 2.8rem 1fr auto; } .ses__f { display: none; } }

  /* ───────────────────────────────────────────────────────────── money */
  .eq { margin-block-end: var(--sp-7); }
  .eq__c { color: var(--coral); margin-block-end: var(--sp-5); }
  .eq__list { display: grid; gap: var(--sp-5); max-inline-size: 44rem; }
  .eq__r { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); column-gap: var(--sp-3); align-items: baseline; }
  .eq__o { font-size: var(--s-1); color: var(--coral); text-align: center; }
  .eq__n { font-family: var(--font-display); font-size: var(--s-1); color: var(--ink-2); }
  .eq__d { grid-column: 2; margin-block-start: 0.25rem; font-size: var(--s--2); line-height: 1.65; color: var(--text-soft); }
  /* The top line is the biggest number on the page; the three deductions are
     indented because they come out of it. */
  .eq__r--top .eq__n { font-size: var(--s-2); }
  .eq__r--take { margin-inline-start: var(--sp-5); }
  /* What survives gets the only block of ink in the section. */
  .eq__r--out { margin-block-start: var(--sp-2); padding: var(--sp-4) var(--sp-5) var(--sp-4) var(--sp-4); }
  .eq__r--out .eq__n { font-size: var(--s-2); }
  @media (max-width: 34rem) { .eq__r--take { margin-inline-start: var(--sp-4); } }

  .money__i { margin-block-end: var(--sp-5); }
  .money__h { font-family: var(--font-display); font-size: var(--s-1); color: var(--ink-2); margin-block: var(--sp-6) var(--sp-3); }
  .terms { display: grid; gap: var(--sp-4); }
  .term { display: grid; grid-template-columns: minmax(6rem, auto) 1fr; gap: var(--sp-4); align-items: baseline; padding-block-end: var(--sp-3); border-block-end: 1px solid var(--line-soft); }
  .term dt { font-family: var(--font-display); font-size: var(--s-1); color: var(--ink-2); }
  .term dd { font-size: var(--s--1); line-height: 1.65; }
  @media (max-width: 34rem) { .term { grid-template-columns: 1fr; gap: var(--sp-2); } }
  .money__ph { display: grid; gap: var(--sp-4); }
  .money__ph h4 { font-size: var(--s--1); font-weight: 700; color: var(--ink-2); margin-block-end: 0.2rem; }
  .money__sys { margin-block-start: var(--sp-5); }
  .money__v { display: grid; gap: var(--sp-5); }
  .money__folds { margin-block-end: var(--sp-7); }

  .lens { display: grid; gap: var(--sp-4); }
  .lens__i { padding: var(--sp-5); background: var(--card); box-shadow: inset 0 0 0 1.4px var(--card-line); }
  .lens__t { display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-3); flex-wrap: wrap; padding-block-end: var(--sp-2); border-block-end: 1px solid var(--line-soft); margin-block-end: var(--sp-3); }
  .lens__t h3 { font-size: var(--s--1); color: var(--ink-2); }
  .lens__g { font-family: var(--font-display); font-size: var(--s-1); color: var(--coral); }
  .lens__i p { font-size: var(--s--1); line-height: 1.72; margin-block-end: var(--sp-3); }
  .lens__i :global(.kicker) { display: block; margin-block-end: 0.15rem; }
  .lens__w { color: var(--coral); }

  .ask { display: grid; gap: var(--sp-4); padding-block-start: var(--sp-7); border-block-start: 1px solid var(--line-soft); }
  .ask__q { color: var(--coral); max-inline-size: 20ch; font-style: italic; }
  .ask__f { font-size: var(--s--1); color: var(--text-soft); max-inline-size: 52ch; line-height: 1.75; }

  /* ───────────────────────────────────────────────────────────── stuck */
  .dx__ctl { display: grid; grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); gap: var(--sp-4); align-items: center; }
  @media (max-width: 48rem) { .dx__ctl { grid-template-columns: 1fr; } }
  .dx__ctl input, .q__ctl input {
    inline-size: 100%; min-block-size: 2.8rem; padding: 0.6rem 0.9rem;
    background: var(--paper); color: var(--text);
    box-shadow: inset 0 0 0 1.4px var(--ink); font-size: var(--s--1);
  }
  .dx__ctl input::placeholder, .q__ctl input::placeholder { color: var(--text-faint); }
  .dx__chips { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .dx__chip {
    padding: 0.3rem 0.7rem; min-block-size: 2.1rem; font-size: var(--s--2); font-weight: 700;
    color: var(--text-soft); box-shadow: inset 0 0 0 1px var(--line);
    transition: background var(--fast) var(--ease), color var(--fast) var(--ease);
  }
  .dx__chip:hover { box-shadow: inset 0 0 0 1px var(--ink); color: var(--ink-2); }
  .dx__chip.is-on { background: var(--ink); color: var(--paper); box-shadow: none; }
  .dx__count, .q__count { font-size: var(--s--2); color: var(--text-faint); margin-block: var(--sp-4) var(--sp-2); }

  .dx__l { display: grid; border-block-start: 1px solid var(--line-soft); }
  .dx__i[hidden] { display: none; }
  .dx__i details { border-block-end: 1px solid var(--line-soft); }
  .dx__i summary { display: grid; grid-template-columns: 1fr auto auto; gap: var(--sp-4); align-items: baseline; padding-block: var(--sp-4); cursor: pointer; list-style: none; }
  .dx__i summary::-webkit-details-marker { display: none; }
  .dx__s { font-family: var(--font-display); font-size: var(--s-1); color: var(--ink-2); line-height: 1.3; }
  .dx__ch { font-size: var(--s--2); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-faint); white-space: nowrap; }
  .dx__p { font-family: var(--font-mono); color: var(--coral); }
  .dx__i details[open] .dx__p::before { content: '–'; }
  .dx__i details[open] .dx__p { font-size: 0; }
  .dx__i details[open] .dx__p::before { font-size: 1rem; }
  .dx__f { display: grid; gap: var(--sp-4); justify-items: start; padding-block-end: var(--sp-5); animation: rise var(--base) var(--ease) both; }
  .dx__f p { font-size: var(--s-0); line-height: 1.78; color: var(--text-soft); max-inline-size: var(--w-read); }
  .dx__more { font-size: var(--s--2); font-weight: 700; color: var(--coral); }
  @media (max-width: 40rem) { .dx__i summary { grid-template-columns: 1fr auto; } .dx__ch { grid-column: 1; grid-row: 2; } .dx__p { grid-row: 1 / span 2; } }
  .dx__none, .q__none { margin-block-start: var(--sp-4); padding: var(--sp-5); box-shadow: inset 0 0 0 1px var(--line); font-size: var(--s--1); color: var(--text-soft); }

  .ss { margin-block-start: var(--sp-7); padding: var(--sp-6); display: grid; gap: var(--sp-3); max-inline-size: 42rem; --shift: 6px; }
  .ss__t { color: var(--ink-2); }
  .ss__b { font-size: var(--s--1); line-height: 1.75; color: var(--text-soft); }
  .ss__l { font-size: var(--s--1); color: var(--ink-2); margin-block: var(--sp-2); }
  .ss__c { font-size: var(--s-1); }

  /* ────────────────────────────────────────────────────────────── flea */
  /* The last day gets the whole width. `.run` would have centred the sheet in
     the page container, leaving paper down both sides of a full-stop moment;
     the ink goes edge to edge and the container moves inside it. */
  .flea {
    display: block;
    max-inline-size: none;
    margin-inline: 0;
    padding-inline: 0;
    padding-block: var(--sp-9);
    background: var(--paper);
  }
  .flea__top { display: grid; gap: var(--sp-4); justify-items: start; padding-block-end: var(--sp-7); }
  .flea__k { color: var(--coral); }
  .flea__seq { font-size: var(--s-2); max-inline-size: 26ch; }
  .flea__n { color: var(--ink); }
  [data-ink='flood'] .flea__n { color: var(--ink); }
  .flea__tags { display: flex; flex-wrap: wrap; gap: var(--sp-2); }

  .flea__story { max-inline-size: 46rem; padding-block: var(--sp-5); }
  .flea__p { font-size: var(--s--1); line-height: 1.8; color: var(--text-soft); margin-block-end: var(--sp-4); }
  .flea__p--lead { font-family: var(--font-display); font-size: var(--s-2); line-height: 1.4; color: var(--text); }

  .flea__cols { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--sp-7); align-items: start; padding-block: var(--sp-6); }
  @media (max-width: 56rem) { .flea__cols { grid-template-columns: 1fr; } }
  .flea__h { font-family: var(--font-display); font-size: var(--s-2); color: var(--text); margin-block-end: var(--sp-4); }
  .flea__why { display: grid; gap: var(--sp-5); }
  .flea__why h4 { font-size: var(--s-0); font-family: var(--font-display); margin-block-end: 0.25rem; }
  .flea__why p { font-size: var(--s--1); line-height: 1.75; color: var(--text-soft); }

  .proof { padding: var(--sp-5); display: grid; gap: var(--sp-3); justify-items: start; --shift: 6px; }
  .proof__b { font-size: var(--s--1); line-height: 1.75; color: var(--text-soft); }
  .proof__l { inline-size: 100%; }

  .prep { padding-block: var(--sp-6); border-block-start: 1px solid var(--line-soft); }
  .prep__l { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr)); gap: var(--sp-6); }
  /* Flex column + auto margin puts every button on the same baseline no
     matter how much copy sits above it. */
  .prep__i {
    display: flex; flex-direction: column; align-items: start;
    gap: var(--sp-3); block-size: 100%;
  }
  .prep__i h4 { font-family: var(--font-display); font-size: var(--s-1); }
  .prep__i h4 .mono { color: var(--coral); font-size: 0.7em; }
  .prep__i p { font-size: var(--s--1); line-height: 1.72; color: var(--text-soft); }
  .prep__i .btn { margin-block-start: auto; }

  .flea__watch { padding-block-start: var(--sp-6); border-block-start: 1px solid var(--line-soft); }
  .flea__wi { font-size: var(--s--1); color: var(--text-soft); max-inline-size: 56ch; margin-block-end: var(--sp-5); }
  .flea__wl { margin-block: var(--sp-5) var(--sp-4); }
  .flea__v { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr)); gap: var(--sp-5); }
  .flea__fp { margin-block-start: var(--sp-4); }

  /* ───────────────────────────────────────────────────────────── asked */
  .q__ctl { display: grid; gap: var(--sp-2); max-inline-size: 26rem; }
  .q__l { border-block-start: 1px solid var(--line-soft); }
  .q__i[hidden] { display: none; }
  .q__i > summary { font-size: var(--s-0); }

  .wip { margin-block-start: var(--sp-8); padding-block-start: var(--sp-6); border-block-start: 1px solid var(--line-soft); }
  .wip__l { margin-block-end: var(--sp-4); }
  .wip__g { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr)); gap: var(--sp-6); }
  .wip__i { display: grid; gap: var(--sp-3); justify-items: start; align-content: start; }
  .wip__i h3 { font-family: var(--font-display); font-size: var(--s-1); color: var(--ink-2); }
  .wip__i p { font-size: var(--s--1); line-height: 1.7; color: var(--text-soft); }
  .wip__p { font-size: var(--s-0); color: var(--text-faint); }
</style>

<script>
  const variants = (t: string) => {
    const v = new Set([t]);
    if (t.endsWith('ies')) v.add(t.slice(0, -3) + 'y');
    if (t.endsWith('es')) v.add(t.slice(0, -2));
    if (t.endsWith('s')) v.add(t.slice(0, -1));
    if (t.length > 4) v.add(t.replace(/(ing|ed)$/, ''));
    return [...v].filter((x) => x.length > 2);
  };
  const hit = (hay: string, t: string) => variants(t).some((v) => hay.includes(v));

  function filter(o: { input: string; chips?: string; items: string; count: string; empty: string; noun: string }) {
    const input = document.querySelector<HTMLInputElement>(o.input);
    const chips = o.chips ? [...document.querySelectorAll<HTMLButtonElement>(o.chips)] : [];
    const items = [...document.querySelectorAll<HTMLElement>(o.items)];
    const count = document.querySelector<HTMLElement>(o.count);
    const empty = document.querySelector<HTMLElement>(o.empty);
    if (!input || !count || !empty || !items.length) return;

    let only = 'all';
    const apply = () => {
      const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const it of items) {
        const hay = it.dataset.text ?? '';
        const ok = (only === 'all' || it.dataset.channel === only) && terms.every((t) => hit(hay, t));
        it.hidden = !ok;
        if (ok) shown++;
        else {
          it.querySelector('details')?.removeAttribute('open');
          if (it instanceof HTMLDetailsElement) it.open = false;
        }
      }
      empty.hidden = shown > 0;
      count.textContent = shown === items.length ? `${items.length} ${o.noun}` : `${shown} of ${items.length} ${o.noun}`;
    };

    input.addEventListener('input', apply);
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        only = c.dataset.filter ?? 'all';
        chips.forEach((x) => {
          const on = x === c;
          x.classList.toggle('is-on', on);
          x.setAttribute('aria-pressed', String(on));
        });
        apply();
      })
    );
  }

  filter({ input: '#dxq', chips: '.dx__chips .dx__chip', items: '.dx__i', count: '.dx__count', empty: '.dx__none', noun: 'things' });
  filter({ input: '#qq', items: '.q__i', count: '.q__count', empty: '.q__none', noun: 'questions' });
</script>
