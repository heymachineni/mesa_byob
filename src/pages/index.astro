---
/**
 * Overview: what the Challenge is, and what you gain. Also the landing spot
 * for every old single-page deep link, which is why it owns the redirects.
 */
import Kit from '../layouts/Kit.astro';
import Clip from '../components/Clip.astro';
import { getProgram } from '../lib/content';
import { legacyTarget } from '../lib/nav';

export const prerender = false;

const legacy = legacyTarget(Astro.url.searchParams);
if (legacy) return Astro.redirect(legacy, 301);

const program = await getProgram();
---

<Kit title="Overview" description={program.heroSupport} current="/">
  <header class="hero">
    <p class="kicker">{program.heroKicker}</p>
    <h1 class="disp disp--xl">{program.heroStatement}</h1>
    <p class="lede hero__l">{program.heroSupport}</p>
    <p class="hero__stats mono">
      {program.weeks} weeks · {program.milestoneCount} milestones · {program.revenueTargetLabel} minimum · {program.teamSizeLabel}
    </p>
    <a class="btn" href="/milestones">Start with the milestones <span class="arrow">→</span></a>

    <dl class="facts">
      <div class="facts__i"><dt>Starts</dt><dd>{program.startLabel}</dd></div>
      <div class="facts__i"><dt>Ends</dt><dd>{program.endLabel}</dd></div>
      <div class="facts__i"><dt>Capital repaid by</dt><dd>{program.repaymentLabel}</dd></div>
      <div class="facts__i"><dt>Tranches</dt><dd>{program.trancheLabel}</dd></div>
    </dl>
  </header>

  <section class="sec" aria-labelledby="about">
    <h2 class="disp disp--md" id="about">What the BYOB Challenge is all about</h2>
    <ul class="grid2">
      {program.structure.map((s) => (
        <li class="card">
          <h3 class="card__t">{s.title}</h3>
          <p class="card__b">{s.body}</p>
        </li>
      ))}
    </ul>
    <p class="aside aside--violet">{program.keyOutcome}</p>
  </section>

  <section class="sec" aria-labelledby="gain">
    <h2 class="disp disp--md" id="gain">What you will gain</h2>
    <p class="lede">{program.gainsIntro}</p>
    <ul class="grid2">
      {program.gains.map((g) => {
        /* The one sentence the programme wants remembered is set apart in the
           body — brightest text on the page, same voice as the headings. */
        const parts = g.highlight ? g.body.split(g.highlight) : null;
        return (
          <li class="card">
            <h3 class="card__t">{g.title}</h3>
            <p class="card__b">
              {parts ? (<>{parts[0]}<strong class="card__hl">{g.highlight}</strong>{parts[1]}</>) : g.body}
            </p>
          </li>
        );
      })}
    </ul>
    <p class="close">{program.closingNote}</p>
  </section>

  <section class="sec sec--watch" aria-labelledby="watch">
    <h2 class="disp disp--sm" id="watch">Watch</h2>
    <div class="watch"><Clip video={program.watch} /></div>
  </section>

  <script is:inline>
    /* Old in-page anchors from the single-page era, sent to their new homes. */
    const MAP = {
      '#brief': '/', '#climb': '/milestones', '#weeks': '/milestones', '#gates': '/milestones',
      '#selling': '/playbook', '#targets': '/playbook', '#workshops': '/workshops',
      '#sessions': '/workshops', '#money': '/playbook/revenue', '#breaks': '/playbook',
      '#flea': '/flea', '#faq': '/faq', '#asked': '/faq', '#still-stuck': '/playbook',
    };
    const to = MAP[location.hash];
    if (to && to !== '/') location.replace(to);
  </script>
</Kit>

<style>
  .hero { display: grid; gap: var(--sp-4); justify-items: start; padding-block-end: var(--sp-7); }
  .hero__l { max-inline-size: 44ch; }
  .hero__stats { font-size: var(--s--2); color: var(--text-faint); letter-spacing: 0.04em; }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(10rem, 100%), 1fr));
    gap: var(--sp-3);
    inline-size: 100%;
    margin-block-start: var(--sp-3);
  }
  .facts__i {
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--r-sm);
    background: var(--card);
    box-shadow: inset 0 0 0 1.4px var(--card-line);
  }
  .facts__i dt {
    font-family: var(--font-mono); font-size: 0.6rem; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-faint);
  }
  .facts__i dd { font-size: var(--s--1); font-weight: 600; color: var(--ink); margin-block-start: 0.2rem; }
  .sec { padding-block: var(--sp-7); border-block-start: 1px solid var(--line-soft); display: grid; gap: var(--sp-5); }
  .grid2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    gap: var(--sp-4);
  }
  .card {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    padding: var(--sp-5);
    border-radius: var(--r-card);
    background: var(--card);
    box-shadow: inset 0 0 0 1.4px var(--card-line);
  }
  .card__t { font-family: var(--font-display); font-size: var(--s-1); color: var(--ink-2); }
  .card__b { font-size: var(--s--1); line-height: 1.7; color: var(--text-soft); }
  .card__hl { font-weight: 700; color: var(--ink); }
  .close { font-size: var(--s--1); line-height: 1.75; color: var(--text-soft); max-inline-size: 62ch; }
  .watch { max-inline-size: 34rem; }
</style>
