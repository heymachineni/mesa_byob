  .split__k li { display: grid; grid-template-columns: 0.55rem 1fr auto; gap: var(--sp-3); align-items: center; font-size: var(--s--1); padding-block: var(--sp-2); border-block-end: 1px solid var(--line-soft); color: var(--text-soft); }
