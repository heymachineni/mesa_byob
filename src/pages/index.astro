  .tbl__code { display: inline-block; margin-inline-end: 0.45rem; font-family: var(--font-mono); font-size: 0.66rem; font-weight: 700; color: var(--coral); }
  .tbl__link { font-weight: 700; color: var(--ink-2); text-decoration: underline; text-decoration-color: var(--coral); text-underline-offset: 0.2em; }
  .tbl__sub { display: block; margin-block-start: var(--sp-2); font-size: var(--s--2); font-weight: 400; color: var(--text-faint); }

  /* ─────────────────────────────────────────────────────────── workshops */
  .ses { display: grid; }
  .ses__r {
    display: grid; grid-template-columns: 3.2rem minmax(0, 1fr) 2.6rem auto; gap: var(--sp-4);
    align-items: baseline; inline-size: 100%; padding-block: var(--sp-4);
